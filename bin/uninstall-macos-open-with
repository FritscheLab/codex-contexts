#!/usr/bin/env bash

set -euo pipefail

APP_DIR="${CODEX_MACOS_APP_DIR:-$HOME/Applications}"
APP_PATH="$APP_DIR/Codex Project.app"
BACKUP_DIR="$APP_DIR/.codex-project-backups"
SERVICES_DIR="${CODEX_MACOS_SERVICES_DIR:-$HOME/Library/Services}"
WORKFLOW_PATH="$SERVICES_DIR/Open in Codex Project.workflow"
WORKFLOW_BACKUP_DIR="$SERVICES_DIR/.codex-project-backups"
TRASH_DIR="${CODEX_MACOS_TRASH_DIR:-$HOME/.Trash}"
VSCODE_OPEN_WITH_DIR="$HOME/Applications"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister"

die() {
  printf 'uninstall-macos-open-with: %s\n' "$*" >&2
  exit 1
}

[[ "$(uname -s)" == "Darwin" ]] || die "this uninstaller is only for macOS"

[[ ! -L "$APP_PATH" && ! -L "$WORKFLOW_PATH" ]] || die "refusing to remove a symlinked app or Quick Action"
if [[ -e "$WORKFLOW_PATH" ]]; then
  [[ "$(/usr/bin/plutil -extract CodexContextsManagedWorkflow raw "$WORKFLOW_PATH/Contents/Info.plist" 2>/dev/null)" == 'codex-contexts-quick-action-v1' ]] ||
    die "refusing to remove an unrelated Quick Action: $WORKFLOW_PATH"
fi
if [[ -d "$VSCODE_OPEN_WITH_DIR" ]]; then
  while IFS= read -r -d '' vscode_handler; do
    [[ ! -L "$vscode_handler" ]] || continue
    marker="$vscode_handler/Contents/Resources/codex-contexts-open-with"
    [[ -f "$marker" && "$(sed -n '1p' "$marker")" == 'codex-contexts-vscode-open-with-v1' ]] || continue
    if [[ "${CODEX_MACOS_SKIP_REGISTER:-0}" != "1" && -x "$LSREGISTER" ]]; then
      "$LSREGISTER" -u "$vscode_handler" >/dev/null 2>&1 || true
    fi
    mkdir -p "$TRASH_DIR"
    handler_name="$(basename "$vscode_handler" .app)"
    mv "$vscode_handler" "$TRASH_DIR/$handler_name.$(date +%Y%m%d-%H%M%S).$$.app"
  done < <(find "$VSCODE_OPEN_WITH_DIR" -maxdepth 1 -type d -name 'VS Code - *.app' -print0)
fi
if [[ ! -e "$APP_PATH" && ! -e "$WORKFLOW_PATH" ]] && \
  { [[ ! -d "$VSCODE_OPEN_WITH_DIR" ]] ||
    ! find "$VSCODE_OPEN_WITH_DIR" -maxdepth 1 -type d -name 'VS Code - *.app' -print -quit | grep -q .; }; then
  printf 'Codex Project and its Quick Action are not installed at the selected locations.\n'
  exit 0
fi

if [[ -e "$APP_PATH" && "${CODEX_MACOS_SKIP_REGISTER:-0}" != "1" && -x "$LSREGISTER" ]]; then
  if ! "$LSREGISTER" -u "$APP_PATH"; then
    printf 'Warning: Launch Services did not unregister the app immediately.\n' >&2
  fi
fi

mkdir -p "$TRASH_DIR"
if [[ -e "$APP_PATH" ]]; then
  TRASH_PATH="$TRASH_DIR/Codex Project.$(date +%Y%m%d-%H%M%S).$$.app"
  mv "$APP_PATH" "$TRASH_PATH"
  printf 'Moved Finder launcher to Trash: %s\n' "$TRASH_PATH"
fi
if [[ -e "$WORKFLOW_PATH" ]]; then
  WORKFLOW_TRASH_PATH="$TRASH_DIR/Open in Codex Project.$(date +%Y%m%d-%H%M%S).$$.workflow"
  mv "$WORKFLOW_PATH" "$WORKFLOW_TRASH_PATH"
  printf 'Moved Finder Quick Action to Trash: %s\n' "$WORKFLOW_TRASH_PATH"
  if [[ "${CODEX_MACOS_SKIP_REGISTER:-0}" != "1" && -x /System/Library/CoreServices/pbs ]]; then
    /System/Library/CoreServices/pbs -update || printf 'Warning: reopen Finder to refresh Quick Actions.\n' >&2
  fi
fi
printf 'Project files, identity homes, credentials, named VS Code editor copies, and dependencies are unchanged.\n'

if [[ -d "$BACKUP_DIR" ]]; then
  printf 'Installer backups remain under %s; inspect them before removing them.\n' "$BACKUP_DIR"
fi
if [[ -d "$WORKFLOW_BACKUP_DIR" ]]; then
  printf 'Quick Action backups remain under %s; inspect them before removing them.\n' "$WORKFLOW_BACKUP_DIR"
fi

if find "$APP_DIR" -maxdepth 1 -type d \
  -name 'Codex Project.backup.*.app' -print -quit 2>/dev/null | grep -q .; then
  printf 'Additional .app backups in %s may appear in Finder; see docs/macos-open-with.md.\n' "$APP_DIR"
fi
