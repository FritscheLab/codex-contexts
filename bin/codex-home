#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPOSITORY_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
CODEX_HOMES_ROOT="${CODEX_HOMES_ROOT:-$HOME/.codex-homes}"
UMGPT_BASE_URL="https://api.toolkit.umgpt.umich.edu/v1"
UMGPT_MODELS_FILE="${CODEX_UMGPT_MODELS_FILE:-$CODEX_HOMES_ROOT/umgpt-models.toml}"
UMGPT_REPOSITORY_MODELS_FILE="$REPOSITORY_ROOT/config/umgpt-models.toml"
PROJECT_ENVRC_MARKER='# Generated by codex-home. Contains machine-local paths; do not commit.'
PROJECT_WORKSPACE_MARKER='// Generated by codex-home. Contains machine-local settings; do not commit.'

usage() {
  cat <<'EOF'
Manage isolated Codex identities and select them per project with direnv.

Usage:
  codex-home create-subscription NAME
  codex-home create-api NAME BASE_URL MODEL API_KEY_ENV
  codex-home create-azure NAME BASE_URL MODEL API_KEY_ENV API_VERSION
  codex-home create-umgpt [MODEL [NAME]]
  codex-home create-umgpt-low [MODEL [NAME]]
  codex-home umgpt-defaults
  codex-home set-umgpt-default umgpt|umgpt-low MODEL
  codex-home apply-umgpt-defaults
  codex-home reset-umgpt-defaults
  codex-home set-umgpt-scope NAME openai-only|low-sensitivity
  codex-home set-key NAME
  codex-home probe-models BASE_URL
  codex-home models NAME
  codex-home snapshot-umgpt-models [NAME [OUTPUT]]
  codex-home login NAME
  codex-home project NAME [PROJECT_DIR]
  codex-home project-change NAME [PROJECT_DIR]
  codex-home project-reset [PROJECT_DIR]
  codex-home project-review [PROJECT_DIR]
  codex-home vscode NAME [PROJECT_DIR]
  codex-home vscode-open-with NAME
  codex-home vscode-project [PROJECT_DIR]
  codex-home run [NAME] [CODEX_ARGS...]
  codex-home run -- [CODEX_ARGS...]
  codex-home doctor NAME
  codex-home show NAME
  codex-home current
  codex-home list [--names]
  codex-home share-skills NAME [SOURCE_DIR]
  codex-home share-skills-all [SOURCE_DIR]

Special identity:
  default    Uses the existing ~/.codex directory; the helper does not create it.

Identity names:
  NAME is an arbitrary local label. It does not detect or grant a plan,
  account, workspace, provider, or model.

Running Codex:
  Omit NAME to use the active CODEX_IDENTITY selected by direnv.
  Use -- before a prompt or subcommand: codex-home run -- resume

Environment:
  CODEX_HOMES_ROOT   Root for additional identities (default: ~/.codex-homes)
  CODEX_UMGPT_MODELS_FILE
                     Local U-M GPT default-model overrides
                     (default: CODEX_HOMES_ROOT/umgpt-models.toml)
  CODEX_VSCODE_EXTENSIONS_DIR
                     Existing VS Code extensions directory to reuse
                     (default: ~/.vscode/extensions when it exists)
  CODEX_VSCODE_CLI  VS Code CLI command or absolute path (auto-detected)
  CODEX_VSCODE_DOCK_LABEL
                     Named macOS VS Code copies (default: 1; 0 uses the installed app)
  CODEX_SKILLS_SOURCE
                     Canonical skills directory (default: ~/.codex/skills)
EOF
}

die() {
  printf 'codex-home: %s\n' "$*" >&2
  exit 1
}

validate_name() {
  local name="$1"
  [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] ||
    die "identity names may contain only letters, numbers, underscores, and hyphens"
}

validate_env_name() {
  local name="$1"
  [[ "$name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] ||
    die "invalid environment-variable name: $name"
}

validate_provider_name() {
  local name="$1"
  case "$name" in
    openai|ollama|lmstudio|amazon-bedrock)
      die "'$name' is a reserved Codex provider ID; choose another identity name"
      ;;
  esac
}

validate_single_line() {
  local description="$1"
  local value="$2"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] ||
    die "$description must fit on one line"
}

is_model_id() {
  [[ "$1" != *$'\n'* && "$1" != *$'\r'* &&
    "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._:/@+-]*$ ]]
}

validate_model_id() {
  local model="$1"
  is_model_id "$model" ||
    die "invalid model ID '$model'"
}

toml_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

shell_double_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//\$/\\\$}"
  value="${value//\`/\\\`}"
  printf '"%s"' "$value"
}

curl_config_quote() {
  local value="$1"
  validate_single_line "curl configuration value" "$value"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

identity_home() {
  local name="$1"
  if [[ "$name" == "default" ]]; then
    printf '%s\n' "$HOME/.codex"
  else
    printf '%s\n' "$CODEX_HOMES_ROOT/$name"
  fi
}

identity_kind() {
  local name="$1"
  local home
  home="$(identity_home "$name")"

  if [[ "$name" == "default" ]]; then
    printf '%s\n' "codex-default"
  elif [[ -f "$home/.identity-kind" ]]; then
    sed -n '1p' "$home/.identity-kind"
  else
    printf '%s\n' "unknown"
  fi
}

identity_label() {
  local name="$1"
  local kind
  kind="$(identity_kind "$name")"

  case "$kind" in
    codex-default) printf '%s\n' "DEFAULT (~/.codex)" ;;
    chatgpt-subscription) printf '%s subscription\n' "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" ;;
    api-key) printf 'API: %s\n' "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" ;;
    umgpt-openai) printf 'U-M GPT (Azure OpenAI): %s\n' "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" ;;
    umgpt-low) printf 'U-M GPT LOW-SENSITIVITY: %s\n' "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" ;;
    *) printf '%s\n' "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" ;;
  esac
}

is_api_key_kind() {
  case "$1" in
    api-key|umgpt-openai|umgpt-low) return 0 ;;
    *) return 1 ;;
  esac
}

is_umgpt_general_text_model() {
  local normalized
  normalized="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$normalized" in
    *image*|*embedding*) return 1 ;;
    *) return 0 ;;
  esac
}

is_umgpt_openai_text_model() {
  is_umgpt_general_text_model "$1" || return 1
  case "$1" in
    gpt-*|o[0-9]*) return 0 ;;
    *) return 1 ;;
  esac
}

validate_umgpt_model() {
  local scope="$1"
  local model="$2"
  validate_model_id "$model"
  case "$scope" in
    openai-only)
      is_umgpt_openai_text_model "$model" ||
        die "U-M GPT Azure OpenAI identities require a GPT or o-series text model; use create-umgpt-low for '$model'"
      ;;
    low-sensitivity)
      is_umgpt_general_text_model "$model" ||
        die "'$model' is an image-generation or embedding model, not a general Codex text model"
      ;;
    *) die "unknown U-M GPT model scope: $scope" ;;
  esac
}

umgpt_scope_for_kind() {
  case "$1" in
    umgpt-openai) printf '%s\n' "openai-only" ;;
    umgpt-low) printf '%s\n' "low-sensitivity" ;;
    *) return 1 ;;
  esac
}

identity_umgpt_scope() {
  local name="$1"
  local home kind base_url
  home="$(identity_home "$name")"
  kind="$(identity_kind "$name")"
  if umgpt_scope_for_kind "$kind"; then
    return 0
  fi
  if [[ "$kind" == "api-key" && -f "$home/config.toml" ]]; then
    base_url="$(config_value "$home/config.toml" "base_url")"
    if [[ "${base_url%/}" == "$UMGPT_BASE_URL" ]]; then
      printf '%s\n' "unset"
      return 0
    fi
  fi
  return 1
}

write_umgpt_models_file() {
  local openai_model="$1"
  local low_model="$2"
  local models_dir staged
  validate_umgpt_model "openai-only" "$openai_model"
  validate_umgpt_model "low-sensitivity" "$low_model"
  models_dir="$(dirname "$UMGPT_MODELS_FILE")"
  [[ ! -d "$UMGPT_MODELS_FILE" ]] ||
    die "U-M GPT models file is a directory: $UMGPT_MODELS_FILE"
  umask 077
  mkdir -p "$models_dir"
  staged="$(mktemp "${UMGPT_MODELS_FILE}.codex-home.XXXXXX")" ||
    die "could not stage $UMGPT_MODELS_FILE"
  {
    printf '%s\n' '# User-editable defaults for the standard U-M GPT identities.'
    printf '%s\n' '# After manual edits, run: codex-home apply-umgpt-defaults'
    printf 'umgpt = %s\n' "$(toml_quote "$openai_model")"
    printf 'umgpt_low = %s\n' "$(toml_quote "$low_model")"
  } > "$staged"
  chmod 600 "$staged"
  mv "$staged" "$UMGPT_MODELS_FILE"
}

umgpt_models_file_value() {
  local file="$1"
  local requested_key="$2"
  local line line_number assignment_pattern empty_pattern key model
  local openai_model low_model openai_seen low_seen
  [[ -f "$file" ]] || die "U-M GPT models file is not a regular file: $file"
  assignment_pattern='^[[:space:]]*(umgpt|umgpt_low)[[:space:]]*=[[:space:]]*"([^"]+)"[[:space:]]*(#.*)?$'
  empty_pattern='^[[:space:]]*(#.*)?$'
  line_number=0
  openai_model=""
  low_model=""
  openai_seen=0
  low_seen=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    if [[ "$line" =~ $empty_pattern ]]; then
      continue
    fi
    if [[ ! "$line" =~ $assignment_pattern ]]; then
      die "unsupported line $line_number in $file; use only quoted umgpt and umgpt_low assignments"
    fi
    key="${BASH_REMATCH[1]}"
    model="${BASH_REMATCH[2]}"
    case "$key" in
      umgpt)
        [[ "$openai_seen" -eq 0 ]] || die "duplicate 'umgpt' in $file"
        openai_model="$model"
        openai_seen=1
        ;;
      umgpt_low)
        [[ "$low_seen" -eq 0 ]] || die "duplicate 'umgpt_low' in $file"
        low_model="$model"
        low_seen=1
        ;;
    esac
  done < "$file"
  [[ "$openai_seen" -eq 1 ]] || die "missing 'umgpt' in $file"
  [[ "$low_seen" -eq 1 ]] || die "missing 'umgpt_low' in $file"
  validate_umgpt_model "openai-only" "$openai_model"
  validate_umgpt_model "low-sensitivity" "$low_model"
  case "$requested_key" in
    umgpt) printf '%s\n' "$openai_model" ;;
    umgpt_low) printf '%s\n' "$low_model" ;;
    *) die "unknown U-M GPT models-file key: $requested_key" ;;
  esac
}

umgpt_repository_default_model() {
  local scope="$1"
  local key
  [[ -f "$UMGPT_REPOSITORY_MODELS_FILE" ]] ||
    die "repository U-M GPT defaults not found: $UMGPT_REPOSITORY_MODELS_FILE"
  case "$scope" in
    openai-only) key="umgpt" ;;
    low-sensitivity) key="umgpt_low" ;;
    *) die "unknown U-M GPT model scope: $scope" ;;
  esac
  umgpt_models_file_value "$UMGPT_REPOSITORY_MODELS_FILE" "$key"
}

ensure_umgpt_models_file() {
  local openai_model low_model home candidate base_url
  if [[ ! -e "$UMGPT_MODELS_FILE" ]]; then
    openai_model="$(umgpt_repository_default_model "openai-only")" || return
    low_model="$(umgpt_repository_default_model "low-sensitivity")" || return
    home="$(identity_home "umgpt")"
    if [[ -f "$home/config.toml" ]]; then
      candidate="$(config_value "$home/config.toml" "model")"
      base_url="$(config_value "$home/config.toml" "base_url")"
      if [[ "${base_url%/}" == "$UMGPT_BASE_URL" ]] &&
        is_model_id "$candidate" && is_umgpt_openai_text_model "$candidate"; then
        openai_model="$candidate"
      fi
    fi
    home="$(identity_home "umgpt-low")"
    if [[ -f "$home/config.toml" ]]; then
      candidate="$(config_value "$home/config.toml" "model")"
      base_url="$(config_value "$home/config.toml" "base_url")"
      if [[ "${base_url%/}" == "$UMGPT_BASE_URL" ]] &&
        is_model_id "$candidate" && is_umgpt_general_text_model "$candidate"; then
        low_model="$candidate"
      fi
    fi
    write_umgpt_models_file "$openai_model" "$low_model"
  fi
  [[ -f "$UMGPT_MODELS_FILE" ]] ||
    die "U-M GPT models file is not a regular file: $UMGPT_MODELS_FILE"
}

umgpt_default_model() {
  local scope="$1"
  local key
  ensure_umgpt_models_file || return
  case "$scope" in
    openai-only) key="umgpt" ;;
    low-sensitivity) key="umgpt_low" ;;
    *) die "unknown U-M GPT model scope: $scope" ;;
  esac
  umgpt_models_file_value "$UMGPT_MODELS_FILE" "$key"
}

replace_identity_model() {
  local name="$1"
  local model="$2"
  local home config staged line replaced
  ensure_identity "$name"
  home="$(identity_home "$name")"
  config="$home/config.toml"
  staged="$(mktemp "${config}.codex-home.XXXXXX")" ||
    die "could not stage $config"
  replaced=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$replaced" -eq 0 && "$line" =~ ^[[:space:]]*model[[:space:]]*= ]]; then
      printf 'model = %s\n' "$(toml_quote "$model")"
      replaced=1
    else
      printf '%s\n' "$line"
    fi
  done < "$config" > "$staged"
  if [[ "$replaced" -ne 1 ]]; then
    rm -f "$staged"
    die "could not find model in $config"
  fi
  chmod 600 "$staged"
  mv "$staged" "$config"
}

check_umgpt_default_identity() {
  local identity="$1"
  local scope="$2"
  local home current_scope
  home="$(identity_home "$identity")"
  [[ -d "$home" ]] || return 0
  ensure_identity "$identity"
  current_scope="$(identity_umgpt_scope "$identity" 2>/dev/null || true)"
  [[ "$current_scope" == "$scope" ]] ||
    die "identity '$identity' is not classified as '$scope'"
}

sync_umgpt_default_identity() {
  local identity="$1"
  local scope="$2"
  local home model current_model
  home="$(identity_home "$identity")"
  if [[ ! -d "$home" ]]; then
    printf 'Skipped %-9s (identity not created yet).\n' "$identity"
    return
  fi
  check_umgpt_default_identity "$identity" "$scope"
  model="$(umgpt_default_model "$scope")"
  current_model="$(config_value "$home/config.toml" "model")"
  if [[ "$current_model" != "$model" ]]; then
    replace_identity_model "$identity" "$model"
    printf 'Updated %-9s to %s.\n' "$identity" "$model"
  else
    printf 'Current %-9s %s.\n' "$identity" "$model"
  fi
}

show_umgpt_defaults() {
  [[ $# -eq 0 ]] || die "usage: codex-home umgpt-defaults"
  local openai_model low_model repository_openai_model repository_low_model
  openai_model="$(umgpt_default_model "openai-only")"
  low_model="$(umgpt_default_model "low-sensitivity")"
  repository_openai_model="$(umgpt_repository_default_model "openai-only")"
  repository_low_model="$(umgpt_repository_default_model "low-sensitivity")"
  printf 'Repository defaults: %s\n' "$UMGPT_REPOSITORY_MODELS_FILE"
  printf '  umgpt     %s\n' "$repository_openai_model"
  printf '  umgpt-low %s\n' "$repository_low_model"
  printf 'Local defaults: %s\n' "$UMGPT_MODELS_FILE"
  printf '  umgpt     %s  (U-M Azure OpenAI text only)\n' "$openai_model"
  printf '  umgpt-low %s  (LOW-SENSITIVITY DATA ONLY)\n' "$low_model"
  printf '%s\n' 'Update locally with set-umgpt-default, or edit the local TOML and run apply-umgpt-defaults.'
  printf '%s\n' 'After a repository update, reset-umgpt-defaults adopts the repository values.'
}

set_umgpt_default() {
  [[ $# -eq 2 ]] || die "usage: codex-home set-umgpt-default umgpt|umgpt-low MODEL"
  local identity="$1"
  local model="$2"
  local scope openai_model low_model
  case "$identity" in
    umgpt) scope="openai-only" ;;
    umgpt-low) scope="low-sensitivity" ;;
    *) die "default identity must be 'umgpt' or 'umgpt-low'" ;;
  esac
  validate_umgpt_model "$scope" "$model"
  check_umgpt_default_identity "$identity" "$scope"
  openai_model="$(umgpt_default_model "openai-only")"
  low_model="$(umgpt_default_model "low-sensitivity")"
  if [[ "$scope" == "openai-only" ]]; then
    openai_model="$model"
  else
    low_model="$model"
  fi
  write_umgpt_models_file "$openai_model" "$low_model"
  printf 'Saved U-M GPT defaults in %s.\n' "$UMGPT_MODELS_FILE"
  sync_umgpt_default_identity "$identity" "$scope"
}

apply_umgpt_defaults() {
  [[ $# -eq 0 ]] || die "usage: codex-home apply-umgpt-defaults"
  # Read and validate both values before changing either identity.
  umgpt_default_model "openai-only" >/dev/null
  umgpt_default_model "low-sensitivity" >/dev/null
  check_umgpt_default_identity "umgpt" "openai-only"
  check_umgpt_default_identity "umgpt-low" "low-sensitivity"
  printf 'Applying U-M GPT defaults from %s.\n' "$UMGPT_MODELS_FILE"
  sync_umgpt_default_identity "umgpt" "openai-only"
  sync_umgpt_default_identity "umgpt-low" "low-sensitivity"
}

reset_umgpt_defaults() {
  [[ $# -eq 0 ]] || die "usage: codex-home reset-umgpt-defaults"
  local openai_model low_model
  openai_model="$(umgpt_repository_default_model "openai-only")"
  low_model="$(umgpt_repository_default_model "low-sensitivity")"
  check_umgpt_default_identity "umgpt" "openai-only"
  check_umgpt_default_identity "umgpt-low" "low-sensitivity"
  write_umgpt_models_file "$openai_model" "$low_model"
  printf 'Reset local U-M GPT defaults from %s.\n' "$UMGPT_REPOSITORY_MODELS_FILE"
  sync_umgpt_default_identity "umgpt" "openai-only"
  sync_umgpt_default_identity "umgpt-low" "low-sensitivity"
}

ensure_identity() {
  local name="$1"
  local home
  validate_name "$name"
  home="${2:-$(identity_home "$name")}"
  [[ -d "$home" ]] || die "identity '$name' does not exist at $home"
  [[ -f "$home/config.toml" ]] || die "identity '$name' has no config.toml at $home"
}

ensure_new_identity() {
  local name="$1"
  local home
  validate_name "$name"
  [[ "$name" != "default" ]] || die "'default' is reserved for the existing ~/.codex identity"
  home="$(identity_home "$name")"
  [[ ! -e "$home" ]] || die "refusing to overwrite existing path: $home"
}

write_identity_kind() {
  local home="$1"
  local kind="$2"
  printf '%s\n' "$kind" > "$home/.identity-kind"
  chmod 600 "$home/.identity-kind"
}

create_subscription() {
  [[ $# -eq 1 ]] || die "usage: codex-home create-subscription NAME"
  local name="$1"
  local home
  ensure_new_identity "$name"
  home="$(identity_home "$name")"

  umask 077
  mkdir -p "$home"
  cat > "$home/config.toml" <<'EOF'
# Separate file-backed authentication keeps this ChatGPT login isolated from
# every other CODEX_HOME. Run: codex-home login <identity>
cli_auth_credentials_store = "file"

[tui]
status_line = ["model-with-reasoning", "context-remaining", "current-dir"]
terminal_title = ["app-name", "project", "model"]
EOF
  chmod 600 "$home/config.toml"
  write_identity_kind "$home" "chatgpt-subscription"

  printf 'Created ChatGPT subscription identity %s\n' "$name"
  printf '  CODEX_HOME: %s\n' "$home"
  printf 'Next: %s login %s\n' "$0" "$name"
}

create_api_identity() {
  local name="$1"
  local base_url="$2"
  local model="$3"
  local key_env="$4"
  local api_version="${5:-}"
  local kind="${6:-api-key}"
  local home

  ensure_new_identity "$name"
  validate_provider_name "$name"
  validate_single_line "base URL" "$base_url"
  validate_single_line "model" "$model"
  validate_env_name "$key_env"
  if [[ -n "$api_version" ]]; then
    validate_single_line "API version" "$api_version"
  fi
  [[ "$base_url" == http://* || "$base_url" == https://* ]] ||
    die "base URL must start with http:// or https://"
  [[ -n "$model" ]] || die "model may not be empty"
  home="$(identity_home "$name")"

  umask 077
  mkdir -p "$home"
  {
    printf 'model = %s\n' "$(toml_quote "$model")"
    printf 'model_provider = %s\n\n' "$(toml_quote "$name")"
    printf '[model_providers.%s]\n' "$name"
    printf 'name = %s\n' "$(toml_quote "Codex identity: $name")"
    printf 'base_url = %s\n' "$(toml_quote "$base_url")"
    printf 'env_key = %s\n' "$(toml_quote "$key_env")"
    if [[ -n "$api_version" ]]; then
      printf 'query_params = { api-version = %s }\n' "$(toml_quote "$api_version")"
    fi
    printf 'wire_api = "responses"\n\n'
    printf '[tui]\n'
    printf 'status_line = ["model-with-reasoning", "context-remaining", "current-dir"]\n'
    printf 'terminal_title = ["app-name", "project", "model"]\n'
  } > "$home/config.toml"
  chmod 600 "$home/config.toml"
  write_identity_kind "$home" "$kind"

  printf 'Created API identity %s\n' "$name"
  printf '  CODEX_HOME: %s\n' "$home"
  printf '  Provider:   %s\n' "$base_url"
  printf '  Model:      %s\n' "$model"
  printf '  Key env:    %s\n' "$key_env"
  if [[ -n "$api_version" ]]; then
    printf '  API version:%s\n' " $api_version"
  fi
  printf 'Next: %s set-key %s\n' "$0" "$name"
}

create_api() {
  [[ $# -eq 4 ]] || die "usage: codex-home create-api NAME BASE_URL MODEL API_KEY_ENV"
  create_api_identity "$@"
}

create_azure() {
  [[ $# -eq 5 ]] ||
    die "usage: codex-home create-azure NAME BASE_URL MODEL API_KEY_ENV API_VERSION"
  create_api_identity "$@"
}

create_umgpt() {
  [[ $# -le 2 ]] || die "usage: codex-home create-umgpt [MODEL [NAME]]"
  local model explicit
  explicit=0
  if [[ $# -ge 1 ]]; then
    model="$1"
    explicit=1
  else
    model="$(umgpt_default_model "openai-only")"
  fi
  local name="${2:-umgpt}"
  validate_umgpt_model "openai-only" "$model"
  if [[ "$name" == "umgpt" && "$explicit" -eq 1 && -e "$UMGPT_MODELS_FILE" ]]; then
    umgpt_models_file_value "$UMGPT_MODELS_FILE" umgpt >/dev/null || return
  fi
  create_api_identity \
    "$name" \
    "$UMGPT_BASE_URL" \
    "$model" \
    "UMGPT_API_KEY" \
    "" \
    "umgpt-openai"
  if [[ "$name" == "umgpt" && "$explicit" -eq 1 ]]; then
    set_umgpt_default "umgpt" "$model"
  fi
  printf '%s\n' "Scope: U-M Azure OpenAI text models only. Use create-umgpt-low for other U-M models."
}

create_umgpt_low() {
  [[ $# -le 2 ]] || die "usage: codex-home create-umgpt-low [MODEL [NAME]]"
  local model explicit
  explicit=0
  if [[ $# -ge 1 ]]; then
    model="$1"
    explicit=1
  else
    model="$(umgpt_default_model "low-sensitivity")"
  fi
  local name="${2:-umgpt-low}"
  validate_umgpt_model "low-sensitivity" "$model"
  if [[ "$name" == "umgpt-low" && "$explicit" -eq 1 && -e "$UMGPT_MODELS_FILE" ]]; then
    umgpt_models_file_value "$UMGPT_MODELS_FILE" umgpt_low >/dev/null || return
  fi
  create_api_identity \
    "$name" \
    "$UMGPT_BASE_URL" \
    "$model" \
    "UMGPT_API_KEY" \
    "" \
    "umgpt-low"
  if [[ "$name" == "umgpt-low" && "$explicit" -eq 1 ]]; then
    set_umgpt_default "umgpt-low" "$model"
  fi
  printf '%s\n' "Scope: broader U-M text models; use only data approved for the selected model."
  printf '%s\n' "LOW-SENSITIVITY label: this is a local warning, not an institutional data classification."
}

config_values() {
  local file="$1"
  local key="$2"
  sed -nE \
    -e "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"([^\"]*)\".*/\\1/p" \
    -e "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*'([^']*)'.*/\\1/p" \
    "$file"
}

config_value() {
  # Drain the producer so large configs cannot fail with SIGPIPE under pipefail.
  config_values "$1" "$2" | sed -n '1p'
}

set_umgpt_scope() {
  [[ $# -eq 2 ]] ||
    die "usage: codex-home set-umgpt-scope NAME openai-only|low-sensitivity"
  local name="$1"
  local scope="$2"
  local home kind base_url model next_kind
  ensure_identity "$name"
  home="$(identity_home "$name")"
  kind="$(identity_kind "$name")"
  is_api_key_kind "$kind" || die "identity '$name' is not an API-key identity"
  base_url="$(config_value "$home/config.toml" "base_url")"
  [[ "${base_url%/}" == "$UMGPT_BASE_URL" ]] ||
    die "identity '$name' does not use the U-M GPT gateway"
  model="$(config_value "$home/config.toml" "model")"
  [[ -n "$model" ]] || die "could not find model in $home/config.toml"
  validate_umgpt_model "$scope" "$model"
  case "$scope" in
    openai-only) next_kind="umgpt-openai" ;;
    low-sensitivity) next_kind="umgpt-low" ;;
  esac
  write_identity_kind "$home" "$next_kind"
  printf "Set %s to %s.\n" "$name" "$(identity_label "$name")"
}

api_key_env_for() {
  local name="$1"
  local home
  home="$(identity_home "$name")"
  config_value "$home/config.toml" "env_key"
}

set_key() {
  [[ $# -eq 1 ]] || die "usage: codex-home set-key NAME"
  local name="$1"
  local home key_env secret
  ensure_identity "$name"
  is_api_key_kind "$(identity_kind "$name")" || die "identity '$name' is not an API-key identity"
  home="$(identity_home "$name")"
  key_env="$(api_key_env_for "$name")"
  [[ -n "$key_env" ]] || die "could not find env_key in $home/config.toml"
  [[ -t 0 ]] || die "set-key requires an interactive terminal so the key is not exposed"

  IFS= read -r -s -p "Enter $key_env for $name: " secret
  printf '\n' >&2
  [[ -n "$secret" ]] || die "key may not be empty"
  validate_single_line "API key" "$secret"

  umask 077
  printf '%s=%s\n' "$key_env" "$(shell_double_quote "$secret")" > "$home/.env"
  chmod 600 "$home/.env"
  unset secret
  printf 'Saved %s in %s with mode 600.\n' "$key_env" "$home/.env"
}

load_secret_env() {
  local home="$1"
  if [[ -f "$home/.env" ]]; then
    set -a
    # This file is owned by the user and created by `codex-home set-key`.
    # shellcheck disable=SC1090
    source "$home/.env"
    set +a
  fi
}

fetch_model_ids() {
  local base_url="$1"
  local api_key="$2"
  local url quoted_url quoted_header response ids status

  command -v curl >/dev/null 2>&1 || die "curl is required for model discovery"
  command -v jq >/dev/null 2>&1 || die "jq is required for model discovery"
  url="${base_url%/}/models"
  quoted_url="$(curl_config_quote "$url")" || return
  quoted_header="$(curl_config_quote "Authorization: Bearer $api_key")" || return

  response="$(
    {
      printf 'url = %s\n' "$quoted_url"
      printf 'header = %s\n' "$quoted_header"
      printf '%s\n' 'silent' 'show-error' 'fail-with-body'
    } | curl --config -
  )" || {
    status=$?
    if [[ -n "$response" ]]; then
      printf '%s\n' "$response" >&2
    fi
    die "model request failed (curl exit $status): $url"
  }

  if ! jq -e . >/dev/null 2>&1 <<< "$response"; then
    printf '%s\n' "$response" >&2
    die "provider returned a non-JSON model response: $url"
  fi

  ids="$(jq -r '
    if (.data? | type) == "array" then .data[]?
    elif (.models? | type) == "array" then .models[]?
    else empty
    end
    | if type == "string" then . else (.id? // .name? // empty) end
  ' <<< "$response")"

  if [[ -z "$ids" ]]; then
    jq . <<< "$response" >&2
    die "the response contained no model IDs"
  fi
  printf '%s\n' "$ids"
}

request_models() {
  local base_url="$1"
  local api_key="$2"
  local scope="${3:-all}"
  local url ids id shown hidden

  url="${base_url%/}/models"
  ids="$(fetch_model_ids "$base_url" "$api_key")"

  case "$scope" in
    all) printf 'Available models from %s:\n' "$url" ;;
    openai-only) printf 'U-M Azure OpenAI text models allowed for this identity from %s:\n' "$url" ;;
    low-sensitivity) printf 'General text models available to this low-sensitivity identity from %s:\n' "$url" ;;
    *) die "unknown model-list scope: $scope" ;;
  esac
  shown=0
  hidden=0
  while IFS= read -r id; do
    if [[ "$scope" == "openai-only" ]] && ! is_umgpt_openai_text_model "$id"; then
      hidden=$((hidden + 1))
      continue
    fi
    if [[ "$scope" == "low-sensitivity" ]] && ! is_umgpt_general_text_model "$id"; then
      hidden=$((hidden + 1))
      continue
    fi
    printf '  %s\n' "$id"
    shown=$((shown + 1))
  done <<< "$ids"
  [[ "$shown" -gt 0 ]] || die "the response contained no models allowed by the '$scope' scope"
  if [[ "$hidden" -gt 0 ]]; then
    printf 'Hidden by this identity scope: %d model(s).\n' "$hidden"
  fi
}

probe_models() {
  [[ $# -eq 1 ]] || die "usage: codex-home probe-models BASE_URL"
  local base_url="$1"
  local secret
  validate_single_line "base URL" "$base_url"
  [[ "$base_url" == http://* || "$base_url" == https://* ]] ||
    die "base URL must start with http:// or https://"
  [[ -t 0 ]] || die "probe-models requires an interactive terminal"

  IFS= read -r -s -p "API key for $base_url: " secret
  printf '\n' >&2
  [[ -n "$secret" ]] || die "key may not be empty"
  validate_single_line "API key" "$secret"
  request_models "$base_url" "$secret"
  unset secret
}

models_for_identity() {
  [[ $# -eq 1 ]] || die "usage: codex-home models NAME"
  local name="$1"
  local home key_env base_url api_key kind scope
  ensure_identity "$name"
  kind="$(identity_kind "$name")"
  is_api_key_kind "$kind" || die "identity '$name' is not an API-key identity"
  home="$(identity_home "$name")"
  key_env="$(api_key_env_for "$name")"
  base_url="$(config_value "$home/config.toml" "base_url")"
  [[ -n "$base_url" ]] || die "could not find base_url in $home/config.toml"
  [[ -n "$key_env" ]] || die "could not find env_key in $home/config.toml"
  load_secret_env "$home"
  api_key="${!key_env:-}"
  [[ -n "$api_key" ]] || die "$key_env is not set; run: codex-home set-key $name"
  scope="$(identity_umgpt_scope "$name" 2>/dev/null || printf '%s\n' "all")"
  if [[ "$scope" == "unset" ]]; then
    printf "Warning: U-M GPT identity '%s' has no model scope; run set-umgpt-scope before launching Codex.\n" "$name" >&2
    scope="all"
  fi
  request_models "$base_url" "$api_key" "$scope"
  unset api_key
}

snapshot_umgpt_models() {
  [[ $# -le 2 ]] || die "usage: codex-home snapshot-umgpt-models [NAME [OUTPUT]]"
  local name="${1:-umgpt}"
  local output="${2:-$REPOSITORY_ROOT/docs/umgpt-models-snapshot.md}"
  local home scope key_env base_url api_key ids sorted_ids id snapshot_date
  local output_dir staged total openai_count low_count excluded_count
  local openai_match low_match note

  ensure_identity "$name"
  scope="$(identity_umgpt_scope "$name" 2>/dev/null || true)"
  case "$scope" in
    openai-only|low-sensitivity) ;;
    unset) die "U-M GPT identity '$name' has no model scope; classify it before generating a snapshot" ;;
    *) die "identity '$name' is not a scoped U-M GPT identity" ;;
  esac
  output_dir="$(dirname "$output")"
  [[ -d "$output_dir" ]] || die "snapshot output directory does not exist: $output_dir"
  [[ ! -L "$output" ]] || die "refusing to replace a symlinked snapshot: $output"
  [[ ! -e "$output" || -f "$output" ]] || die "snapshot output is not a regular file: $output"
  validate_umgpt_identity_config "$name"
  home="$(identity_home "$name")"
  key_env="$(api_key_env_for "$name")"
  base_url="$(config_value "$home/config.toml" "base_url")"
  load_secret_env "$home"
  api_key="${!key_env:-}"
  [[ -n "$api_key" ]] || die "$key_env is not set; run: codex-home set-key $name"
  ids="$(fetch_model_ids "$base_url" "$api_key")"
  unset api_key

  while IFS= read -r id; do
    is_model_id "$id" || die "the gateway returned an invalid model ID; snapshot not updated"
  done <<< "$ids"
  sorted_ids="$(printf '%s\n' "$ids" | LC_ALL=C sort -u)"

  snapshot_date="${CODEX_UMGPT_SNAPSHOT_DATE:-$(date +%Y-%m-%d)}"
  [[ "$snapshot_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
    die "CODEX_UMGPT_SNAPSHOT_DATE must use YYYY-MM-DD"

  total=0
  openai_count=0
  low_count=0
  excluded_count=0
  while IFS= read -r id; do
    total=$((total + 1))
    if is_umgpt_openai_text_model "$id"; then
      openai_count=$((openai_count + 1))
    fi
    if is_umgpt_general_text_model "$id"; then
      low_count=$((low_count + 1))
    else
      excluded_count=$((excluded_count + 1))
    fi
  done <<< "$sorted_ids"

  staged="$(mktemp "$output_dir/.umgpt-models-snapshot.XXXXXX")" ||
    die "could not stage snapshot beside $output"

  if ! {
    printf '%s\n\n' '<!-- Generated by `codex-home snapshot-umgpt-models`; do not edit manually. -->'
    printf '%s\n\n' '# U-M GPT model snapshot'
    printf -- '- **Generated:** %s\n' "$snapshot_date"
    printf -- '- **Source:** `%s/models`\n' "${base_url%/}"
    printf -- '- **Advertised to identity:** `%s`\n' "$name"
    printf -- '- **Advertised IDs:** %d\n' "$total"
    printf -- '- **Matches `umgpt`:** %d\n' "$openai_count"
    printf -- '- **Matches `umgpt-low`:** %d\n' "$low_count"
    printf -- '- **Excluded from both text scopes:** %d\n\n' "$excluded_count"
    printf '%s\n' '> This is a dated observation of one credential’s `/models` response, not a runtime catalog, compatibility claim, or institutional approval list. “Matches” means only that an ID passes the local name-based filter in this checkout. Run `codex-home models NAME` for live results.'
    printf '\n%s\n\n' 'Runtime validation never reads this file.'
    printf '%s\n' '| Model ID | `umgpt` rule | `umgpt-low` rule | Local classification |'
    printf '%s\n' '|---|---|---|---|'
    while IFS= read -r id; do
      if is_umgpt_openai_text_model "$id"; then
        openai_match="Matches"
        low_match="Matches"
        note="GPT/o-series ID without image/embedding"
      elif is_umgpt_general_text_model "$id"; then
        openai_match="Does not match"
        low_match="Matches"
        note="Other ID without image/embedding"
      else
        openai_match="Does not match"
        low_match="Does not match"
        note="ID contains image or embedding"
      fi
      printf '| `%s` | %s | %s | %s |\n' "$id" "$openai_match" "$low_match" "$note"
    done <<< "$sorted_ids"
  } > "$staged"; then
    rm -f "$staged"
    die "could not write snapshot: $output"
  fi
  chmod 644 "$staged"
  if ! mv "$staged" "$output"; then
    rm -f "$staged"
    die "could not install snapshot: $output"
  fi
  printf 'Updated U-M GPT model snapshot: %s\n' "$output"
}

validate_umgpt_identity_config() {
  local name="$1"
  local scope home config model provider base_url key_env
  scope="$(identity_umgpt_scope "$name" 2>/dev/null || true)"
  [[ -n "$scope" ]] || return 0
  [[ "$scope" != "unset" ]] ||
    die "U-M GPT identity '$name' has no model scope; run: codex-home set-umgpt-scope $name openai-only"
  home="$(identity_home "$name")"
  config="$home/config.toml"
  model="$(config_value "$config" "model")"
  provider="$(config_value "$config" "model_provider")"
  base_url="$(config_value "$config" "base_url")"
  key_env="$(config_value "$config" "env_key")"
  [[ "$provider" == "$name" ]] || die "U-M GPT identity '$name' must use model_provider = \"$name\""
  [[ "${base_url%/}" == "$UMGPT_BASE_URL" ]] || die "U-M GPT identity '$name' has an unexpected base URL"
  [[ "$key_env" == "UMGPT_API_KEY" ]] || die "U-M GPT identity '$name' must use UMGPT_API_KEY"
  [[ -n "$model" ]] || die "could not find model in $config"
  validate_umgpt_model "$scope" "$model"
  if [[ "$scope" == "openai-only" ]] &&
    grep -Eq '^[[:space:]]*model_catalog_json[[:space:]]*=' "$config"; then
    die "U-M GPT Azure OpenAI identities may not set model_catalog_json; the standard Codex catalog keeps the picker OpenAI-only"
  fi
}

validate_project_umgpt_model() {
  local name="$1"
  local project_abs="$2"
  local scope project_config project_model
  scope="$(identity_umgpt_scope "$name" 2>/dev/null || true)"
  [[ -n "$scope" && "$scope" != "unset" ]] || return 0
  project_config="$project_abs/.codex/config.toml"
  [[ -f "$project_config" ]] || return 0
  while IFS= read -r project_model; do
    [[ -n "$project_model" ]] || die "project config contains an empty model: $project_config"
    validate_umgpt_model "$scope" "$project_model"
  done < <(config_values "$project_config" "model")
  if grep -Eq '^[[:space:]]*(model_provider|openai_base_url)[[:space:]]*=' "$project_config"; then
    die "project config may not override the provider for U-M GPT identities: $project_config"
  fi
  if [[ "$scope" == "openai-only" ]] &&
    grep -Eq '^[[:space:]]*model_catalog_json[[:space:]]*=' "$project_config"; then
    die "project config may not install a custom model catalog for the U-M GPT Azure OpenAI identity: $project_config"
  fi
}

umgpt_config_override_is_blocked() {
  local scope="$1"
  local override="$2"
  local key
  [[ "$override" == *=* ]] || return 1
  key="${override%%=*}"
  key="$(printf '%s' "$key" | tr -d '[:space:]')"
  case "$key" in
    model|model_provider|model_catalog_json|openai_base_url|profile|model_providers.*)
      return 0
      ;;
    features.api_key_model_discovery|features.remote_models)
      [[ "$scope" == "openai-only" ]]
      return
      ;;
    *) return 1 ;;
  esac
}

prepare_umgpt_codex_args() {
  local name="$1"
  local scope="$2"
  shift 2
  local home configured_model arg value feature end_options model_seen
  home="$(identity_home "$name")"
  configured_model="$(config_value "$home/config.toml" "model")"
  UMGPT_SCOPED_MODEL="$configured_model"
  UMGPT_SCOPED_ARGS=()
  end_options=0
  model_seen=0

  while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    if [[ "$end_options" == 1 ]]; then
      UMGPT_SCOPED_ARGS+=("$arg")
      continue
    fi
    case "$arg" in
      --)
        end_options=1
        UMGPT_SCOPED_ARGS+=("$arg")
        ;;
      -m|--model)
        [[ $# -gt 0 ]] || die "$arg requires a model ID"
        [[ "$model_seen" == 0 ]] || die "specify the model only once"
        UMGPT_SCOPED_MODEL="$1"
        model_seen=1
        shift
        ;;
      --model=*)
        [[ "$model_seen" == 0 ]] || die "specify the model only once"
        UMGPT_SCOPED_MODEL="${arg#--model=}"
        model_seen=1
        ;;
      -m?*)
        [[ "$model_seen" == 0 ]] || die "specify the model only once"
        UMGPT_SCOPED_MODEL="${arg#-m}"
        model_seen=1
        ;;
      -c|--config)
        [[ $# -gt 0 ]] || die "$arg requires key=value"
        value="$1"
        shift
        if umgpt_config_override_is_blocked "$scope" "$value"; then
          die "'$value' can bypass the U-M GPT '$scope' model scope; use --model with an allowed model instead"
        fi
        UMGPT_SCOPED_ARGS+=("$arg" "$value")
        ;;
      --config=*)
        value="${arg#--config=}"
        if umgpt_config_override_is_blocked "$scope" "$value"; then
          die "'$value' can bypass the U-M GPT '$scope' model scope; use --model with an allowed model instead"
        fi
        UMGPT_SCOPED_ARGS+=("$arg")
        ;;
      -c?*)
        value="${arg#-c}"
        if umgpt_config_override_is_blocked "$scope" "$value"; then
          die "'$value' can bypass the U-M GPT '$scope' model scope; use --model with an allowed model instead"
        fi
        UMGPT_SCOPED_ARGS+=("$arg")
        ;;
      -p|--profile|--oss|--local-provider|--remote|--ignore-user-config)
        die "'$arg' can bypass the U-M GPT '$scope' model scope; use a separate identity"
        ;;
      --profile=*|--local-provider=*|--remote=*|-p?*)
        die "'$arg' can bypass the U-M GPT '$scope' model scope; use a separate identity"
        ;;
      --enable)
        [[ $# -gt 0 ]] || die "--enable requires a feature name"
        feature="$1"
        shift
        if [[ "$scope" == "openai-only" &&
          ( "$feature" == "api_key_model_discovery" || "$feature" == "remote_models" ) ]]; then
          die "feature '$feature' can bypass the U-M GPT Azure OpenAI model scope"
        fi
        UMGPT_SCOPED_ARGS+=("$arg" "$feature")
        ;;
      --enable=*)
        feature="${arg#--enable=}"
        if [[ "$scope" == "openai-only" &&
          ( "$feature" == "api_key_model_discovery" || "$feature" == "remote_models" ) ]]; then
          die "feature '$feature' can bypass the U-M GPT Azure OpenAI model scope"
        fi
        UMGPT_SCOPED_ARGS+=("$arg")
        ;;
      *) UMGPT_SCOPED_ARGS+=("$arg") ;;
    esac
  done
  validate_umgpt_model "$scope" "$UMGPT_SCOPED_MODEL"
}

login_identity() {
  [[ $# -eq 1 ]] || die "usage: codex-home login NAME"
  local name="$1"
  local home
  ensure_identity "$name"
  [[ "$(identity_kind "$name")" == "chatgpt-subscription" ]] ||
    die "login is only for a ChatGPT subscription identity"
  home="$(identity_home "$name")"
  printf 'Opening ChatGPT login for %s using CODEX_HOME=%s\n' "$name" "$home"
  exec env CODEX_HOME="$home" CODEX_IDENTITY="$name" codex login
}

run_identity() {
  local name
  local home label context_name scope
  local -a codex_args
  if [[ $# -eq 0 || "${1:-}" == -* ]]; then
    name="${CODEX_IDENTITY:-}"
    [[ -n "$name" ]] ||
      die "no active project context; enter a direnv-enabled project or use: codex-home run NAME"
    if [[ "${1:-}" == "--" ]]; then
      shift
    fi
  else
    name="$1"
    shift
  fi
  ensure_identity "$name"
  validate_umgpt_identity_config "$name"
  home="$(identity_home "$name")"
  label="$(identity_label "$name")"
  scope="$(identity_umgpt_scope "$name" 2>/dev/null || true)"
  if [[ -n "$scope" ]]; then
    prepare_umgpt_codex_args "$name" "$scope" "$@"
    codex_args=(--model "$UMGPT_SCOPED_MODEL" "${UMGPT_SCOPED_ARGS[@]}")
  else
    codex_args=("$@")
  fi
  load_secret_env "$home"
  export CODEX_HOME="$home"
  export CODEX_IDENTITY="$name"

  if [[ -t 0 && -t 1 && -t 2 && "${TERM:-dumb}" != "dumb" ]]; then
    context_name="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"
    # Save the terminal's title, then keep the context visible while Codex runs.
    # Clear our label on exit; terminals with a title stack restore the old title.
    printf '\033[22;0t\033]0;[CODEX: %s]\007' "$context_name" >&2
    trap 'printf "\033]0;\007\033[23;0t" >&2' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    printf '\n\033[1;7m  [CODEX: %s]  \033[0m\n\n' "$context_name" >&2

    # An empty list stops Codex replacing the title with its project/model.
    if [[ "$scope" == "low-sensitivity" ]]; then
      printf '\033[1;31m  LOW-SENSITIVITY DATA ONLY: verify the selected model before use.  \033[0m\n\n' >&2
    fi
    codex -c 'tui.terminal_title=[]' "${codex_args[@]}"
    return
  fi

  printf 'Codex identity: %s\n' "$label" >&2
  if [[ "$scope" == "low-sensitivity" ]]; then
    printf '%s\n' 'LOW-SENSITIVITY DATA ONLY: verify the selected model before use.' >&2
  fi
  exec codex "${codex_args[@]}"
}

doctor_identity() {
  [[ $# -eq 1 ]] || die "usage: codex-home doctor NAME"
  local name="$1"
  local home
  ensure_identity "$name"
  validate_umgpt_identity_config "$name"
  home="$(identity_home "$name")"
  load_secret_env "$home"
  printf 'Checking %s with CODEX_HOME=%s\n' "$(identity_label "$name")" "$home"
  exec env CODEX_HOME="$home" CODEX_IDENTITY="$name" codex --strict-config doctor --summary
}

status_bar_color() {
  local name="$1"
  local kind="$2"
  case "$kind" in
    codex-default) printf '%s\n' "#57606A" ;;
    chatgpt-subscription)
      if [[ "$name" == "pro" ]]; then
        printf '%s\n' "#0969DA"
      elif [[ "$name" == "business" ]]; then
        printf '%s\n' "#6F42C1"
      else
        printf '%s\n' "#1F883D"
      fi
      ;;
    api-key) printf '%s\n' "#B35C00" ;;
    umgpt-openai) printf '%s\n' "#00274C" ;;
    umgpt-low) printf '%s\n' "#B31B1B" ;;
    *) printf '%s\n' "#57606A" ;;
  esac
}

gitignore_escape_literal() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\*/\\*}"
  value="${value//\?/\\?}"
  value="${value//\[/\\[}"
  printf '%s' "$value"
}

project_workspace_git_path() {
  local project_abs="$1"
  local project_name
  [[ "$project_abs" != "/" ]] || die "the filesystem root cannot be used as a project"
  project_name="$(basename "$project_abs")"
  printf '.vscode/%s.code-workspace\n' "$project_name"
}

project_workspace_path() {
  local project_abs="$1"
  printf '%s/%s\n' "$project_abs" "$(project_workspace_git_path "$project_abs")"
}

legacy_project_workspace_path() {
  local project_abs="$1"
  printf '%s/.vscode/codex-context.code-workspace\n' "$project_abs"
}

ensure_project_files_untracked() {
  local project_abs="$1"
  local workspace="$2"
  local workspace_rel
  if ! git -C "$project_abs" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi
  workspace_rel="${workspace#"$project_abs/"}"
  [[ "$workspace_rel" != "$workspace" ]] ||
    die "VS Code workspace is outside the project: $workspace"
  if git -C "$project_abs" ls-files --error-unmatch -- .envrc >/dev/null 2>&1; then
    die "refusing to manage .envrc because that path is already tracked by Git"
  fi
  if git -C "$project_abs" ls-files --error-unmatch -- "$workspace_rel" \
    >/dev/null 2>&1; then
    die "refusing to manage $workspace_rel because that path is already tracked by Git"
  fi
}

project_git_exclude_details() {
  local project_abs="$1"
  local project_prefix exclude_file escaped_prefix workspace_rel
  local escaped_workspace escaped_legacy_workspace

  project_prefix="$(git -C "$project_abs" rev-parse --show-prefix)" ||
    die "could not determine the Git path for $project_abs"
  exclude_file="$(cd "$project_abs" && git rev-parse --git-path info/exclude)" ||
    die "could not locate the repository's local Git exclude file"
  if [[ "$exclude_file" != /* ]]; then
    exclude_file="$project_abs/$exclude_file"
  fi

  escaped_prefix="$(gitignore_escape_literal "$project_prefix")"
  workspace_rel="$(project_workspace_git_path "$project_abs")"
  escaped_workspace="$(gitignore_escape_literal "${project_prefix}${workspace_rel}")"
  escaped_legacy_workspace="$(
    gitignore_escape_literal "${project_prefix}.vscode/codex-context.code-workspace"
  )"
  printf '%s\n' "$exclude_file"
  printf '/%s.envrc\n' "$escaped_prefix"
  printf '/%s\n' "$escaped_workspace"
  printf '/%s\n' "$escaped_legacy_workspace"
}

add_project_git_excludes() {
  local project_abs="$1"
  local details exclude_file envrc_pattern workspace_pattern

  if ! git -C "$project_abs" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi

  ensure_project_files_untracked "$project_abs" "$(project_workspace_path "$project_abs")"
  details="$(project_git_exclude_details "$project_abs")" || return
  {
    IFS= read -r exclude_file
    IFS= read -r envrc_pattern
    IFS= read -r workspace_pattern
  } <<< "$details"

  if grep -Fqx -- "$envrc_pattern" "$exclude_file" 2>/dev/null &&
    grep -Fqx -- "$workspace_pattern" "$exclude_file" 2>/dev/null; then
    printf '%s\n' "$exclude_file"
    return 0
  fi

  mkdir -p "$(dirname "$exclude_file")" || return
  if [[ -s "$exclude_file" ]]; then
    printf '\n' >> "$exclude_file" || return
  fi
  printf '%s\n' '# Added by codex-home; machine-local project configuration.' >> "$exclude_file" || return
  if ! grep -Fqx -- "$envrc_pattern" "$exclude_file" 2>/dev/null; then
    printf '%s\n' "$envrc_pattern" >> "$exclude_file" || return
  fi
  if ! grep -Fqx -- "$workspace_pattern" "$exclude_file" 2>/dev/null; then
    printf '%s\n' "$workspace_pattern" >> "$exclude_file" || return
  fi
  printf '%s\n' "$exclude_file"
}

remove_project_git_excludes() {
  local project_abs="$1"
  local scope="${2:-all}"
  local details exclude_file envrc_pattern workspace_pattern
  local legacy_workspace_pattern exclude_tmp

  if ! git -C "$project_abs" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi

  details="$(project_git_exclude_details "$project_abs")" || return
  {
    IFS= read -r exclude_file
    IFS= read -r envrc_pattern
    IFS= read -r workspace_pattern
    IFS= read -r legacy_workspace_pattern
  } <<< "$details"
  [[ -f "$exclude_file" ]] || return 0
  if [[ "$scope" == legacy ]]; then
    [[ "$legacy_workspace_pattern" != "$workspace_pattern" ]] || return 0
  fi

  exclude_tmp="$(mktemp "${exclude_file}.codex-home.XXXXXX")" || return
  if ! CODEX_EXCLUDE_SCOPE="$scope" CODEX_ENVRC_PATTERN="$envrc_pattern" \
    CODEX_WORKSPACE_PATTERN="$workspace_pattern" \
    CODEX_LEGACY_WORKSPACE_PATTERN="$legacy_workspace_pattern" \
    awk '
      $0 == ENVIRON["CODEX_LEGACY_WORKSPACE_PATTERN"] { next }
      ENVIRON["CODEX_EXCLUDE_SCOPE"] != "legacy" &&
        ($0 == ENVIRON["CODEX_ENVRC_PATTERN"] ||
         $0 == ENVIRON["CODEX_WORKSPACE_PATTERN"]) { next }
      { print }
    ' "$exclude_file" > "$exclude_tmp"; then
    rm -f "$exclude_tmp"
    die "could not update $exclude_file"
  fi
  if ! mv "$exclude_tmp" "$exclude_file"; then
    rm -f "$exclude_tmp"
    die "could not update $exclude_file"
  fi
  if [[ "$scope" != legacy ]]; then
    printf '%s\n' "$exclude_file"
  fi
}

render_project_envrc() {
  local name="$1"
  local helper_dir="${2:-$SCRIPT_DIR}"
  local home label home_quoted helper_quoted
  home="$(identity_home "$name")" || return
  label="$(identity_label "$name")" || return
  validate_single_line "identity home" "$home"
  validate_single_line "helper path" "$helper_dir"
  home_quoted="$(shell_double_quote "$home")" || return
  helper_quoted="$(shell_double_quote "$helper_dir")" || return
  cat <<EOF
$PROJECT_ENVRC_MARKER
export CODEX_IDENTITY="$name"
export CODEX_HOME=$home_quoted

if [[ ! -d "\$CODEX_HOME" ]]; then
  log_error "Missing Codex identity directory: \$CODEX_HOME"
  return 1
fi

dotenv_if_exists "\$CODEX_HOME/.env"
PATH_add $helper_quoted
watch_file "\$CODEX_HOME/config.toml"
if [[ -f "\$CODEX_HOME/.env" ]]; then
  watch_file "\$CODEX_HOME/.env"
fi
log_status "Codex identity: $label | CODEX_HOME=\$CODEX_HOME"
EOF
}

render_project_workspace() {
  local name="$1"
  local project_name="$2"
  local kind color identity_short folder_name_json window_title window_title_json
  kind="$(identity_kind "$name")" || return
  color="$(status_bar_color "$name" "$kind")" || return
  identity_short="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')" || return
  folder_name_json="$(jq -Rn --arg value "$project_name" '$value')" || return
  window_title="$project_name [CODEX: $identity_short]"
  window_title_json="$(jq -Rn --arg value "$window_title" '$value')" || return
  printf '%s\n' "$PROJECT_WORKSPACE_MARKER" || return
  cat <<EOF
{
  "folders": [
    { "name": $folder_name_json, "path": ".." }
  ],
  "settings": {
    "window.title": $window_title_json,
    "workbench.colorCustomizations": {
      "statusBar.background": "$color",
      "statusBar.foreground": "#FFFFFF",
      "statusBar.noFolderBackground": "$color",
      "statusBar.debuggingBackground": "$color"
    }
  }
}
EOF
}

render_legacy_project_workspace() {
  local name="$1"
  local include_marker="${2:-1}"
  local kind label color
  kind="$(identity_kind "$name")" || return
  label="$(identity_label "$name")" || return
  color="$(status_bar_color "$name" "$kind")" || return
  if [[ "$include_marker" == "1" ]]; then
    printf '%s\n' "$PROJECT_WORKSPACE_MARKER" || return
  fi
  cat <<EOF
{
  "folders": [
    { "path": ".." }
  ],
  "settings": {
    "window.title": "[CODEX: $label] \${dirty}\${activeEditorShort}\${separator}\${rootName}\${separator}\${appName}",
    "workbench.colorCustomizations": {
      "statusBar.background": "$color",
      "statusBar.foreground": "#FFFFFF",
      "statusBar.noFolderBackground": "$color",
      "statusBar.debuggingBackground": "$color"
    }
  }
}
EOF
}

write_project_templates() (
  local name="$1"
  local project_abs="$2"
  local envrc="$project_abs/.envrc"
  local project_name workspace
  local envrc_tmp="" workspace_tmp="" backup_dir="" restore=0

  cleanup_project_templates() {
    local status=$? keep_backups=0 target backup
    trap - EXIT HUP INT TERM
    if [[ "$restore" == 1 ]]; then
      for target in "$envrc" "$workspace"; do
        if [[ "$target" == "$envrc" ]]; then
          backup="$backup_dir/envrc"
        else
          backup="$backup_dir/workspace"
        fi
        if [[ -f "$backup" ]]; then
          mv -f "$backup" "$target" || keep_backups=1
        else
          rm -f "$target" || keep_backups=1
        fi
      done
    fi
    [[ -z "$envrc_tmp" ]] || rm -f "$envrc_tmp"
    [[ -z "$workspace_tmp" ]] || rm -f "$workspace_tmp"
    if [[ -n "$backup_dir" ]]; then
      if [[ "$keep_backups" == 1 ]]; then
        printf 'codex-home: restoration failed; recover original files from %s before reopening this project\n' "$backup_dir" >&2
        status=1
      else
        rm -f "$backup_dir/envrc" "$backup_dir/workspace"
        rmdir "$backup_dir"
      fi
    fi
    exit "$status"
  }

  project_name="$(basename "$project_abs")" || return
  workspace="$(project_workspace_path "$project_abs")" || return
  umask 077
  trap cleanup_project_templates EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mkdir -p "$project_abs/.vscode" || die "could not create the project workspace directory"
  envrc_tmp="$(mktemp "$project_abs/.envrc.codex-home.XXXXXX")" || die "could not stage .envrc"
  workspace_tmp="$(mktemp "${workspace}.codex-home.XXXXXX")" || die "could not stage the workspace"
  if ! render_project_envrc "$name" > "$envrc_tmp" ||
    ! render_project_workspace "$name" "$project_name" > "$workspace_tmp"; then
    die "could not render project configuration"
  fi
  backup_dir="$(mktemp -d "$project_abs/.codex-home-backup.XXXXXX")" || die "could not prepare project backups"
  if [[ -f "$envrc" ]]; then
    cp -p "$envrc" "$backup_dir/envrc" || die "could not back up $envrc"
  fi
  if [[ -f "$workspace" ]]; then
    cp -p "$workspace" "$backup_dir/workspace" || die "could not back up $workspace"
  fi
  restore=1
  mv "$envrc_tmp" "$envrc" || die "could not replace $envrc"
  mv "$workspace_tmp" "$workspace" || die "could not replace $workspace"
  restore=0
)

generated_project_identity() {
  local envrc="$1"
  local name helper_dir="" helper_quoted remaining character expected

  [[ -f "$envrc" && ! -L "$envrc" ]] || return 1
  [[ "$(sed -n '1p' "$envrc")" == "$PROJECT_ENVRC_MARKER" ]] || return 1
  name="$(sed -n 's/^export CODEX_IDENTITY="\([a-zA-Z0-9][a-zA-Z0-9_-]*\)"$/\1/p' "$envrc")"
  [[ -n "$name" && "$(grep -Ec '^export CODEX_IDENTITY=' "$envrc")" -eq 1 ]] || return 1
  helper_quoted="$(sed -n 's/^PATH_add //p' "$envrc")" || return 1
  [[ "$helper_quoted" == \"*\" && "$(grep -Ec '^PATH_add ' "$envrc")" -eq 1 ]] || return 1
  remaining="${helper_quoted:1:${#helper_quoted}-2}"
  # Decode only shell_double_quote's literal format; never evaluate project code.
  while [[ -n "$remaining" ]]; do
    character="${remaining:0:1}"
    remaining="${remaining:1}"
    case "$character" in
      \\)
        character="${remaining:0:1}"
        remaining="${remaining:1}"
        case "$character" in \\|\"|\$|\`) ;; *) return 1 ;; esac
        ;;
      \"|\$|\`) return 1 ;;
    esac
    helper_dir+="$character"
  done
  [[ "$helper_dir" == /* ]] || return 1
  expected="$(render_project_envrc "$name" "$helper_dir")" || return 1
  cmp -s "$envrc" <(printf '%s\n' "$expected") || return 1
  printf '%s\n' "$name"
}

workspace_matches_generated_template() {
  local workspace="$1"
  local name="$2"
  local project_abs="$3"
  local project_name expected

  [[ -f "$workspace" && ! -L "$workspace" ]] || return 1
  project_name="$(basename "$project_abs")"
  expected="$(render_project_workspace "$name" "$project_name")" || return 1
  if cmp -s "$workspace" <(printf '%s\n' "$expected"); then return 0; fi
  expected="$(render_legacy_project_workspace "$name")" || return 1
  cmp -s "$workspace" <(printf '%s\n' "$expected") ||
    cmp -s "$workspace" <(printf '%s\n' "${expected#*$'\n'}")
}

managed_project_workspace() {
  local project_abs="$1"
  local workspace legacy_workspace
  workspace="$(project_workspace_path "$project_abs")"
  legacy_workspace="$(legacy_project_workspace_path "$project_abs")"

  if [[ "$workspace" != "$legacy_workspace" &&
    ( -e "$workspace" || -L "$workspace" ) &&
    ( -e "$legacy_workspace" || -L "$legacy_workspace" ) ]]; then
    die "refusing to choose between both $workspace and $legacy_workspace"
  fi
  if [[ -e "$workspace" || -L "$workspace" ]]; then
    printf '%s\n' "$workspace"
  elif [[ -e "$legacy_workspace" || -L "$legacy_workspace" ]]; then
    printf '%s\n' "$legacy_workspace"
  else
    printf '%s\n' "$workspace"
  fi
}

managed_project_identity() {
  local project_abs="$1"
  local workspace="$2"
  local envrc="$project_abs/.envrc"
  local name

  [[ ! -L "$project_abs/.vscode" ]] ||
    die "refusing to manage a project whose .vscode directory is a symbolic link"
  name="$(generated_project_identity "$envrc")" ||
    die "refusing to replace $envrc because it does not exactly match a generated codex-home file"
  workspace_matches_generated_template "$workspace" "$name" "$project_abs" ||
    die "refusing to replace $workspace because it does not exactly match a generated codex-home file"
  ensure_project_files_untracked "$project_abs" "$workspace"
  printf '%s\n' "$name"
}

write_project_files() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: codex-home project NAME [PROJECT_DIR]"
  local name="$1"
  local project_dir="${2:-.}"
  local project_abs envrc workspace legacy_workspace git_exclude
  ensure_identity "$name"
  [[ -d "$project_dir" ]] || die "project directory does not exist: $project_dir"
  project_abs="$(cd "$project_dir" && pwd -P)"
  validate_single_line "project path" "$project_abs"
  envrc="$project_abs/.envrc"
  workspace="$(project_workspace_path "$project_abs")"
  legacy_workspace="$(legacy_project_workspace_path "$project_abs")"

  [[ ! -e "$envrc" && ! -L "$envrc" ]] ||
    die "refusing to overwrite existing $envrc (see docs/projects-vscode.md for the block to add manually)"
  [[ ! -e "$workspace" && ! -L "$workspace" ]] ||
    die "refusing to overwrite existing $workspace"
  if [[ "$legacy_workspace" != "$workspace" ]]; then
    [[ ! -e "$legacy_workspace" && ! -L "$legacy_workspace" ]] ||
      die "refusing to replace existing workspace $legacy_workspace"
  fi
  if [[ -e "$project_abs/.vscode" ]]; then
    [[ -d "$project_abs/.vscode" && ! -L "$project_abs/.vscode" ]] ||
      die "refusing to use $project_abs/.vscode because it is not a regular directory"
  fi

  git_exclude="$(add_project_git_excludes "$project_abs")" || return
  write_project_templates "$name" "$project_abs" || return

  printf 'Configured %s for %s\n' "$project_abs" "$(identity_label "$name")"
  printf '  direnv:   %s\n' "$envrc"
  printf '  VS Code:  %s\n' "$workspace"
  if [[ -n "$git_exclude" ]]; then
    printf '  Git:      locally excluded by %s\n' "$git_exclude"
  else
    printf '  Git:      not inside a Git work tree; no exclusion was needed\n'
  fi
  printf 'Next:\n'
  printf '  direnv allow %q\n' "$project_abs"
  printf '  %q vscode %q %q\n' "$0" "$name" "$project_abs"
}

revoke_project_approval() {
  local project_abs="$1"
  local deny_error

  if deny_error="$(direnv deny "$project_abs" 2>&1)"; then
    return 0
  fi
  # A missing approval file means there is no approval left to revoke.
  case "$deny_error" in
    "direnv: error remove "*/direnv/allow/*": no such file or directory")
      return 0
      ;;
  esac
  printf '%s\n' "$deny_error" >&2
  die "could not revoke direnv approval for $project_abs"
}

change_project_files() {
  [[ $# -ge 1 && $# -le 2 ]] ||
    die "usage: codex-home project-change NAME [PROJECT_DIR]"
  local name="$1"
  local project_dir="${2:-.}"
  local project_abs previous_name workspace new_workspace git_exclude
  ensure_identity "$name"
  command -v direnv >/dev/null 2>&1 || die "direnv is not installed"
  [[ -d "$project_dir" ]] || die "project directory does not exist: $project_dir"
  project_abs="$(cd "$project_dir" && pwd -P)"
  validate_single_line "project path" "$project_abs"
  workspace="$(managed_project_workspace "$project_abs")"
  previous_name="$(managed_project_identity "$project_abs" "$workspace")"
  new_workspace="$(project_workspace_path "$project_abs")"
  if [[ "$workspace" != "$new_workspace" ]]; then
    [[ ! -e "$new_workspace" && ! -L "$new_workspace" ]] ||
      die "refusing to overwrite existing $new_workspace"
  fi

  revoke_project_approval "$project_abs"
  git_exclude="$(add_project_git_excludes "$project_abs")" || return
  write_project_templates "$name" "$project_abs" || return
  if [[ "$workspace" != "$new_workspace" ]]; then
    rm -f "$workspace" || return
    remove_project_git_excludes "$project_abs" legacy || return
  fi

  printf 'Changed %s from %s to %s.\n' "$project_abs" "$previous_name" "$(identity_label "$name")"
  printf '  direnv:   %s/.envrc (approval revoked; review before allowing)\n' "$project_abs"
  printf '  VS Code:  %s\n' "$new_workspace"
  if [[ -n "$git_exclude" ]]; then
    printf '  Git:      locally excluded by %s\n' "$git_exclude"
  fi
  printf 'Next:\n'
  printf '  direnv allow %q\n' "$project_abs"
  printf '  %q vscode %q %q\n' "$0" "$name" "$project_abs"
}

reset_project_files() {
  [[ $# -le 1 ]] || die "usage: codex-home project-reset [PROJECT_DIR]"
  local project_dir="${1:-.}"
  local project_abs previous_name workspace git_exclude
  command -v direnv >/dev/null 2>&1 || die "direnv is not installed"
  [[ -d "$project_dir" ]] || die "project directory does not exist: $project_dir"
  project_abs="$(cd "$project_dir" && pwd -P)"
  validate_single_line "project path" "$project_abs"
  workspace="$(managed_project_workspace "$project_abs")"
  previous_name="$(managed_project_identity "$project_abs" "$workspace")"

  revoke_project_approval "$project_abs"
  rm -f "$project_abs/.envrc" "$workspace"
  rmdir "$project_abs/.vscode" >/dev/null 2>&1 || true
  git_exclude="$(remove_project_git_excludes "$project_abs")" || return

  printf 'Removed generated Codex project context for %s (was %s).\n' \
    "$project_abs" "$previous_name"
  if [[ -n "$git_exclude" ]]; then
    printf '  Git:      removed this project\047s patterns from %s\n' "$git_exclude"
  fi
  printf 'Identity homes, credentials, .codex, and unrelated VS Code settings were not changed.\n'
}

resolve_vscode_cli() {
  local configured="${CODEX_VSCODE_CLI:-}"
  local candidate

  if [[ -n "$configured" ]]; then
    if [[ "$configured" == */* ]]; then
      [[ -x "$configured" ]] || die "CODEX_VSCODE_CLI is not executable: $configured"
      printf '%s\n' "$configured"
      return 0
    fi
    command -v "$configured" >/dev/null 2>&1 ||
      die "CODEX_VSCODE_CLI command was not found: $configured"
    command -v "$configured"
    return 0
  fi

  if command -v code >/dev/null 2>&1; then
    command -v code
    return 0
  fi

  for candidate in \
    "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" \
    "$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" \
    "/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code"
  do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  die "VS Code CLI was not found; install the 'code' shell command or set CODEX_VSCODE_CLI"
}

# Only standard VS Code bundles qualify for a named editor copy.
macos_vscode_executable() {
  local cli="$1" target contents executable identifier hops=0
  while [[ -L "$cli" ]]; do
    hops=$((hops + 1))
    [[ "$hops" -le 40 ]] || return 1
    target="$(readlink "$cli")" || return 1
    if [[ "$target" == /* ]]; then cli="$target"; else cli="$(dirname "$cli")/$target"; fi
  done
  case "$cli" in
    *.app/Contents/Resources/app/bin/code|*.app/Contents/Resources/app/bin/code-insiders) ;;
    *) return 1 ;;
  esac
  contents="$(cd "$(dirname "$cli")/../../.." && pwd -P)" || return 1
  identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$contents/Info.plist" 2>/dev/null)" || return 1
  case "$identifier" in com.microsoft.VSCode|com.microsoft.VSCodeInsiders) ;; *) return 1 ;; esac
  executable="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$contents/Info.plist" 2>/dev/null)" || return 1
  [[ -n "$executable" && "$executable" != */* && -x "$contents/MacOS/$executable" ]] || return 1
  printf '%s\n' "$contents/MacOS/$executable"
}

macos_vscode_is_running() {
  local data="$1" pid
  [[ -f "$data/code.lock" ]] || return 1
  pid="$(cat "$data/code.lock")"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  # A stale/reused PID can only defer a copy refresh. Routing always uses the
  # chosen editor's CLI with this identity's explicit user-data directory.
  kill -0 "$pid" 2>/dev/null
}

macos_vscode_source_metadata() {
  local app="$1" executable="$2" plist_hash executable_stat product_hash=""
  plist_hash="$(shasum -a 256 "$app/Contents/Info.plist")" || return 1
  executable_stat="$(/usr/bin/stat -f '%d:%i:%m:%c:%z' "$executable")" || return 1
  if [[ -f "$app/Contents/Resources/app/product.json" ]]; then
    product_hash="$(shasum -a 256 "$app/Contents/Resources/app/product.json")" || return 1
  fi
  printf 'codex-contexts-vscode-editor-v1\n%s\n%s\n%s\n%s\n' \
    "$app" "$plist_hash" "$executable_stat" "$product_hash"
}

macos_vscode_open_with_path() {
  printf '%s/Applications/VS Code - %s.app\n' "$HOME" "$1"
}

macos_vscode_unregister_editor() {
  local app="$1"
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister"
  [[ "${CODEX_MACOS_SKIP_REGISTER:-0}" != "1" ]] || return 0
  [[ -d "$app" && -x "$lsregister" ]] || return 0
  "$lsregister" -u "$app" >/dev/null 2>&1 || true
}

ensure_macos_vscode_open_with() (
  set -e
  umask 077
  local name="$1" home="$2" app_dir app source marker metadata build candidate info_plist
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister"
  local plist_buddy="/usr/libexec/PlistBuddy"
  local runtime_app="$home/vscode-editor/VS Code - $name.app"
  [[ "${CODEX_MACOS_SKIP_REGISTER:-0}" != "1" ]] || return 0
  app="$(macos_vscode_open_with_path "$name")" || die "could not determine the VS Code Finder app path"
  app_dir="$(dirname "$app")"
  source="$SCRIPT_DIR/VSCodeIdentity.applescript"
  [[ -f "$source" ]] || source="$REPOSITORY_ROOT/macos/VSCodeIdentity.applescript"
  [[ -f "$source" ]] || die "missing the VS Code Finder handler source"
  [[ -f "$SCRIPT_DIR/../config/umgpt-models.toml" ]] || die "missing bundled U-M GPT model defaults"
  command -v osacompile >/dev/null 2>&1 || die "osacompile is required for VS Code Finder entries"
  [[ -x /usr/bin/codesign && -x "$plist_buddy" ]] || die "required macOS application tools were not found"
  [[ ! -L "$app_dir" ]] || die "refusing a symbolic link at $app_dir"
  mkdir -p "$app_dir" || die "could not create $app_dir"
  app_dir="$(cd "$app_dir" && pwd -P)" || die "could not open $app_dir"
  app="$app_dir/VS Code - $name.app"
  [[ ! -L "$app" ]] || die "refusing a symbolic link at $app"
  metadata="$(shasum -a 256 "$source" "$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")" "$SCRIPT_DIR/../config/umgpt-models.toml")" || return 1
  metadata="$(printf 'codex-contexts-vscode-open-with-v1\n%s\n%s' "$name" "$metadata")"
  marker="$app/Contents/Resources/codex-contexts-open-with"
  if [[ -e "$app" ]]; then
    [[ -d "$app" && -f "$marker" ]] || die "refusing to replace an unowned Finder app: $app"
  fi
  if [[ -f "$marker" ]] && [[ "$(cat "$marker")" == "$metadata" ]]; then
    macos_vscode_unregister_editor "$runtime_app"
    [[ ! -x "$lsregister" ]] || "$lsregister" -f "$app" >/dev/null 2>&1 || true
    return 0
  fi

  build="$(mktemp -d "$app_dir/.vscode-open-with.XXXXXX")" || die "could not stage the VS Code Finder app"
  cleanup_vscode_open_with() {
    local status=$?
    if [[ "$status" -ne 0 && -d "$build/previous.app" && ! -e "$app" && ! -L "$app" ]]; then
      mv "$build/previous.app" "$app" || true
    fi
    if [[ "$status" -ne 0 && -e "$build/previous.app" ]]; then
      printf 'Previous Finder app preserved at %s; restore it to %s after resolving the installation failure.\n' \
        "$build/previous.app" "$app" >&2
    else
      rm -rf -- "$build"
    fi
    return "$status"
  }
  trap cleanup_vscode_open_with EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  candidate="$build/VS Code - $name.app"
  osacompile -o "$candidate" "$source" || die "could not compile the VS Code Finder app"
  # Callers may handle failure with ||, which disables Bash's errexit here.
  mkdir -p "$candidate/Contents/config" || die "could not create the Finder app config directory"
  cp "$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")" "$candidate/Contents/Resources/codex-home" ||
    die "could not bundle the Finder app helper"
  cp "$source" "$candidate/Contents/Resources/VSCodeIdentity.applescript" ||
    die "could not bundle the Finder handler source"
  cp "$SCRIPT_DIR/../config/umgpt-models.toml" "$candidate/Contents/config/umgpt-models.toml" ||
    die "could not bundle the U-M GPT model defaults"
  printf '%s\n' "$name" >"$candidate/Contents/Resources/identity" || die "could not record the Finder app identity"
  printf '%s\n' "$metadata" >"$candidate/Contents/Resources/codex-contexts-open-with" ||
    die "could not record the Finder app ownership marker"
  info_plist="$candidate/Contents/Info.plist"
  "$plist_buddy" -c 'Delete :CFBundleIdentifier' "$info_plist" >/dev/null 2>&1 || true
  "$plist_buddy" -c "Add :CFBundleIdentifier string org.codex-contexts.vscode.$name" "$info_plist" || die "could not configure the Finder app identifier"
  "$plist_buddy" -c 'Delete :CFBundleName' "$info_plist" >/dev/null 2>&1 || true
  "$plist_buddy" -c "Add :CFBundleName string VS Code - $name" "$info_plist" || die "could not configure the Finder app name"
  "$plist_buddy" -c 'Delete :CFBundleDisplayName' "$info_plist" >/dev/null 2>&1 || true
  "$plist_buddy" -c "Add :CFBundleDisplayName string VS Code - $name" "$info_plist" || die "could not configure the Finder app display name"
  "$plist_buddy" -c 'Delete :LSUIElement' "$info_plist" >/dev/null 2>&1 || true
  "$plist_buddy" -c 'Add :LSUIElement bool true' "$info_plist" || die "could not configure the Finder app UI behavior"
  "$plist_buddy" -c 'Delete :CFBundleDocumentTypes' "$info_plist" >/dev/null 2>&1 || true
  "$plist_buddy" -c 'Add :CFBundleDocumentTypes array' "$info_plist" || die "could not configure Finder document types"
  "$plist_buddy" -c 'Add :CFBundleDocumentTypes:0 dict' "$info_plist" || die "could not configure the Finder folder handler"
  "$plist_buddy" -c 'Add :CFBundleDocumentTypes:0:CFBundleTypeName string Folder' "$info_plist" || die "could not configure the Finder folder type"
  "$plist_buddy" -c 'Add :CFBundleDocumentTypes:0:CFBundleTypeRole string Editor' "$info_plist" || die "could not configure the Finder folder role"
  "$plist_buddy" -c 'Add :CFBundleDocumentTypes:0:LSHandlerRank string Alternate' "$info_plist" || die "could not configure the Finder handler rank"
  "$plist_buddy" -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes array' "$info_plist" || die "could not configure Finder content types"
  "$plist_buddy" -c 'Add :CFBundleDocumentTypes:0:LSItemContentTypes:0 string public.folder' "$info_plist" || die "could not configure the Finder folder content type"
  chmod 700 "$candidate/Contents/Resources/codex-home" || die "could not make the Finder app helper executable"
  /usr/bin/codesign --force --deep --sign - "$candidate" >/dev/null || die "could not sign the VS Code Finder app"
  macos_vscode_unregister_editor "$runtime_app"
  if [[ -e "$app" ]]; then mv "$app" "$build/previous.app" || die "could not stage the old VS Code Finder app"; fi
  mv "$candidate" "$app" || die "could not install $app"
  if [[ -x "$lsregister" ]]; then "$lsregister" -f "$app" >/dev/null 2>&1 || true; fi
)

# Preserve the vendor signature by changing only the outer bundle filename.
# APFS clones share data blocks; cp falls back to a normal copy.
# Keep ownership and source metadata outside the signed bundle.
prepare_macos_vscode_editor() (
  set -e
  umask 077
  local name="$1" home="$2" executable="$3"
  local cache app marker source_app metadata build candidate status installed=0
  cache="$home/vscode-editor"
  [[ ! -L "$cache" ]] || die "refusing a symbolic link at $cache"
  mkdir -p "$cache" || die "could not create the named editor directory: $cache"
  cache="$(cd "$cache" && pwd -P)" || die "could not open the named editor directory"
  app="$cache/VS Code - $name.app"
  marker="$cache/source"
  [[ ! -L "$app" && ! -L "$marker" && ! -L "$cache/.build-lock" ]] ||
    die "refusing symlinked named editor files"
  if [[ -e "$marker" ]]; then
    [[ -f "$marker" && "$(sed -n '1p' "$marker")" == 'codex-contexts-vscode-editor-v1' ]] ||
      die "refusing an unrecognized named editor marker: $marker"
  fi
  if [[ -e "$app" ]]; then
    [[ -d "$app" && -f "$marker" ]] || die "refusing to replace an unowned named editor: $app"
  fi
  source_app="$(dirname "$(dirname "$(dirname "$executable")")")"
  validate_single_line "VS Code application path" "$source_app"
  if [[ "$source_app" == "$app" ]]; then
    printf '%s\n' "$app"
    exit 0
  fi
  metadata="$(macos_vscode_source_metadata "$source_app" "$executable")" ||
    die "could not inspect the source VS Code application"
  if [[ -d "$app" && "$(cat "$marker")" == "$metadata" ]]; then
    printf '%s\n' "$app"
    exit 0
  fi
  if [[ -d "$app" ]] && macos_vscode_is_running "$home/vscode-user-data"; then
    printf 'VS Code update pending for %s; quit this identity and reopen through Codex Project to refresh its named editor.\n' "$name" >&2
    printf '%s\n' "$app"
    exit 0
  fi

  # lockf owns a kernel lock on this descriptor. It waits only for rebuilds,
  # releases automatically after a crash, and safely reuses leftover files.
  exec 9>"$cache/.build-lock" || die "could not open the named editor preparation lock"
  /usr/bin/lockf -s -t 20 9 || die "timed out waiting for the named editor to finish preparing"
  metadata="$(macos_vscode_source_metadata "$source_app" "$executable")" ||
    die "could not inspect the source VS Code application"
  if [[ -d "$app" && "$(cat "$marker")" == "$metadata" ]]; then
    printf '%s\n' "$app"
    exit 0
  fi
  if [[ -d "$app" ]] && macos_vscode_is_running "$home/vscode-user-data"; then
    printf 'VS Code update pending for %s; quit this identity and reopen through Codex Project to refresh its named editor.\n' "$name" >&2
    printf '%s\n' "$app"
    exit 0
  fi

  build="$(mktemp -d "$cache/.build.XXXXXX")" || die "could not stage the named editor"
  cleanup_macos_editor() {
    status=$?
    if [[ "$status" -ne 0 && -d "$build/previous.app" ]]; then
      if [[ "$installed" == 1 ]]; then mv "$app" "$build/failed.app" || true; fi
      if [[ ! -e "$app" ]]; then mv "$build/previous.app" "$app" || true; fi
    fi
    # Keep the backup if restoring it failed; never delete the only old copy.
    if [[ "$status" == 0 || ! -e "$build/previous.app" ]]; then
      rm -rf -- "$build"
    fi
    return "$status"
  }
  trap cleanup_macos_editor EXIT
  candidate="$build/VS Code - $name.app"
  /bin/cp -cR "$source_app" "$candidate" || die "could not copy the VS Code application"
  /usr/bin/codesign --verify --deep --strict "$candidate" || die "the copied VS Code signature did not verify"
  [[ -x "$candidate/Contents/Resources/app/bin/code" ||
    -x "$candidate/Contents/Resources/app/bin/code-insiders" ]] || die "the copied VS Code CLI is missing"
  [[ "$(macos_vscode_source_metadata "$source_app" "$executable")" == "$metadata" ]] ||
    die "VS Code changed while its named copy was being prepared; try again"
  printf '%s\n' "$metadata" >"$build/source" || die "could not record the source editor metadata"
  if [[ -d "$app" ]] && macos_vscode_is_running "$home/vscode-user-data"; then
    printf 'VS Code update pending for %s; its editor started during preparation. Reopen after quitting to refresh.\n' "$name" >&2
    printf '%s\n' "$app"
    exit 0
  fi
  # Establish ownership before the first install. A crash before the metadata
  # commit leaves a recognized incomplete cache that can be rebuilt safely.
  if [[ ! -e "$marker" ]]; then
    printf 'codex-contexts-vscode-editor-v1\npending\n' >"$build/pending" || die "could not prepare the editor ownership marker"
    mv "$build/pending" "$marker" || die "could not install the editor ownership marker"
  fi
  if [[ -e "$app" ]]; then
    mv "$app" "$build/previous.app" || die "could not stage the previous named editor"
  fi
  if ! mv "$candidate" "$app"; then
    die "could not install the named VS Code editor"
  fi
  installed=1
  mv "$build/source" "$marker" || die "could not commit the named editor source metadata"
  printf '%s\n' "$app"
)

launch_vscode_from_dock() {
  [[ "$(uname -s)" == Darwin && $# -ge 2 && $# -le 3 ]] || die "invalid Dock launcher invocation"
  local name="$1" state="$2" project
  # Saved-project launches use the same validation and CLI as folder launches.
  if [[ $# -eq 3 ]]; then project="$3"; else project="$(cat "$state")"; fi
  launch_vscode "$name" "$project"
}

review_project_envrc() {
  [[ $# -le 1 ]] || die "usage: codex-home project-review [PROJECT_DIR]"
  local project_dir="${1:-.}"
  local project_abs envrc workspace name vscode_cli review_dir review_dir_q
  local review_file baseline

  [[ -d "$project_dir" ]] || die "project directory does not exist: $project_dir"
  project_abs="$(cd "$project_dir" && pwd -P)"
  validate_single_line "project path" "$project_abs"
  envrc="$project_abs/.envrc"
  workspace="$(managed_project_workspace "$project_abs")"
  name="$(managed_project_identity "$project_abs" "$workspace")"
  vscode_cli="$(resolve_vscode_cli)"

  review_dir="$(mktemp -d "${TMPDIR:-/tmp}/codex-envrc-review.XXXXXX")"
  printf -v review_dir_q '%q' "$review_dir"
  trap "chmod 700 $review_dir_q 2>/dev/null || true; rm -rf -- $review_dir_q" EXIT HUP INT TERM
  review_file="$review_dir/$(basename "$project_abs").envrc-review.sh"
  baseline="$review_dir/.envrc-baseline"
  cp "$envrc" "$review_file"
  cp "$envrc" "$baseline"
  chmod 400 "$review_file" "$baseline"
  chmod 500 "$review_dir"

  printf 'Opening a read-only review snapshot for %s.\n' "$(identity_label "$name")"
  printf 'Close the VS Code review window to return to the approval prompt.\n'
  "$vscode_cli" --new-window --wait --disable-extensions "$review_file"

  cmp -s "$baseline" "$envrc" ||
    die "$envrc changed while it was being reviewed; review it again before approval"
  cmp -s "$baseline" "$review_file" ||
    die "the read-only review snapshot was modified; no change was applied to $envrc"
  managed_project_identity "$project_abs" "$workspace" >/dev/null

  chmod 700 "$review_dir"
  rm -rf -- "$review_dir"
  trap - EXIT HUP INT TERM
}

project_direnv_exec() {
  env -u CODEX_IDENTITY -u CODEX_HOME \
    -u DIRENV_DIFF -u DIRENV_DIR -u DIRENV_FILE -u DIRENV_WATCHES \
    direnv exec "$@"
}

launch_vscode_project_env() {
  local project_dir="$1" expected_name="$2"
  local project_abs helper vscode_cli extensions_dir homes_root
  command -v direnv >/dev/null 2>&1 || die "direnv is not installed"
  [[ -d "$project_dir" ]] || die "project directory does not exist: $project_dir"
  project_abs="$(cd "$project_dir" && pwd -P)"
  validate_single_line "project path" "$project_abs"
  # direnv treats an unreadable .envrc as absent. Read it explicitly so a
  # privacy denial is reported before selecting an identity.
  if ! cat "$project_abs/.envrc" >/dev/null; then
    die "cannot read $project_abs/.envrc; check the file and Codex Project's folder access in macOS Privacy & Security"
  fi

  helper="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
  vscode_cli="$(resolve_vscode_cli)"
  extensions_dir="${CODEX_VSCODE_EXTENSIONS_DIR:-$HOME/.vscode/extensions}"
  homes_root="$CODEX_HOMES_ROOT"
  [[ "$homes_root" == /* ]] || homes_root="$PWD/$homes_root"
  # Pin launcher settings and the identity registry from the caller. Load the
  # project's environment once, then validate and execute within that process.
  project_direnv_exec "$project_abs" /usr/bin/env CODEX_HOMES_ROOT="$homes_root" \
    "$BASH" "$helper" _vscode-loaded "$project_abs" "$expected_name" \
    "$HOME/.codex" "$vscode_cli" "$extensions_dir" "${CODEX_VSCODE_DOCK_LABEL:-1}"
}

project_launch_home() {
  local project="$1" default_home="$2"
  local name="${CODEX_IDENTITY:-}" selected_home="${CODEX_HOME:-}" expected_home
  [[ -n "$name" && -n "$selected_home" ]] ||
    die "direnv did not load a Codex identity from $project/.envrc; check direnv status for denied approval or a skipped file"
  if [[ "$name" == default ]]; then
    expected_home="$default_home"
  else
    expected_home="$(identity_home "$name")"
  fi
  ensure_identity "$name" "$expected_home"
  [[ -d "$selected_home" ]] || die "project's CODEX_HOME does not exist: $selected_home"
  [[ "$(cd "$selected_home" && pwd -P)" == "$(cd "$expected_home" && pwd -P)" ]] ||
    die "project selects identity '$name' but CODEX_HOME is '$selected_home'; expected '$expected_home'"
  printf '%s\n' "$expected_home"
}

launch_vscode_loaded() {
  [[ $# -eq 6 ]] || die "invalid internal VS Code launch invocation"
  local project_abs="$1" expected_name="$2" default_home="$3"
  local vscode_cli="$4" extensions_dir="$5" dock_label="$6"
  local name workspace home vscode_data macos_executable dock_app="" running_pid running_command
  local -a code_args
  cd "$project_abs"
  home="$(project_launch_home "$project_abs" "$default_home")"
  name="$CODEX_IDENTITY"
  validate_umgpt_identity_config "$name"
  validate_project_umgpt_model "$name" "$project_abs"
  [[ -z "$expected_name" || "$name" == "$expected_name" ]] ||
    die "project selects '$name', not '$expected_name'; open it with the selected identity or review its .envrc"
  workspace="$(managed_project_workspace "$project_abs")"
  [[ -f "$workspace" ]] || die "missing $workspace; run: codex-home project $name '$project_abs'"

  vscode_data="$home/vscode-user-data"
  mkdir -p "$vscode_data"
  code_args=(
    --new-window
    --user-data-dir "$vscode_data"
  )

  if [[ -d "$extensions_dir" ]]; then
    code_args+=(--extensions-dir "$extensions_dir")
  fi
  code_args+=("$workspace")

  printf 'Launching isolated VS Code as %s.\n' "$(identity_label "$name")"
  if [[ "$(identity_umgpt_scope "$name" 2>/dev/null || true)" == "low-sensitivity" ]]; then
    printf '%s\n' '  LOW-SENSITIVITY DATA ONLY: verify the selected model before use.'
  fi
  printf '  User data: %s\n' "$vscode_data"
  if [[ -d "$extensions_dir" ]]; then
    printf '  Extensions: %s\n' "$extensions_dir"
  else
    printf '  Extensions: isolated (install openai.chatgpt in this window)\n'
  fi
  printf 'Start a new Codex chat after the window opens.\n'
  if [[ "$(uname -s)" == Darwin ]]; then
    ensure_macos_vscode_open_with "$name" "$home" ||
      printf 'Warning: could not refresh the Finder Open With entry for VS Code - %s.\n' "$name" >&2
    if [[ "$dock_label" != 0 ]] && macos_executable="$(macos_vscode_executable "$vscode_cli")"; then
      dock_app="$(prepare_macos_vscode_editor "$name" "$home" "$macos_executable")"
      printf '  Named editor: %s\n' "$dock_app"
      vscode_cli="$dock_app/Contents/Resources/app/bin/code"
      if [[ ! -x "$vscode_cli" ]]; then
        vscode_cli="$dock_app/Contents/Resources/app/bin/code-insiders"
      fi
      if macos_vscode_is_running "$vscode_data"; then
        running_pid="$(cat "$vscode_data/code.lock")"
        running_command="$(/bin/ps -p "$running_pid" -o comm= 2>/dev/null || true)"
        if [[ "$running_command" == "$macos_executable" && "$running_command" != "$dock_app/Contents/MacOS/"* ]]; then
          printf 'The current editor still uses its previous Dock name. Quit this identity\047s VS Code instance and reopen through Codex Project to use VS Code - %s.\n' "$name" >&2
        fi
      fi
    fi
  fi
  local launch_status=0
  if "$vscode_cli" "${code_args[@]}"; then
    :
  else
    launch_status=$?
  fi
  macos_vscode_unregister_editor "$dock_app"
  return "$launch_status"
}

register_vscode_open_with() {
  [[ $# -eq 1 ]] || die "usage: codex-home vscode-open-with NAME"
  [[ "$(uname -s)" == Darwin ]] || die "VS Code Finder entries are only available on macOS"
  local name="$1" home
  ensure_identity "$name"
  home="$(identity_home "$name")"
  ensure_macos_vscode_open_with "$name" "$home"
  printf 'Finder Open With entry: %s\n' "$(macos_vscode_open_with_path "$name")"
}

launch_vscode() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: codex-home vscode NAME [PROJECT_DIR]"
  ensure_identity "$1"
  launch_vscode_project_env "${2:-.}" "$1"
}

launch_vscode_project() {
  [[ $# -le 1 ]] || die "usage: codex-home vscode-project [PROJECT_DIR]"
  launch_vscode_project_env "${1:-.}" ""
}

show_identity() {
  local name="$1"
  local home="${2:-}"
  local kind label config model provider base_url key_env key_status auth_status umgpt_scope
  if [[ -z "$home" ]]; then
    ensure_identity "$name"
    home="$(identity_home "$name")"
  fi
  kind="$(identity_kind "$name")"
  label="$(identity_label "$name")"
  config="$home/config.toml"
  model=""
  provider=""
  base_url=""
  key_env=""
  if [[ -f "$config" ]]; then
    model="$(config_value "$config" "model")"
    provider="$(config_value "$config" "model_provider")"
    base_url="$(config_value "$config" "base_url")"
    key_env="$(config_value "$config" "env_key")"
  fi
  [[ -n "$model" ]] || model="Codex default"
  [[ -n "$provider" ]] || provider="openai"

  printf 'Codex identity : %s\n' "$label"
  printf 'Auth kind      : %s\n' "$kind"
  printf 'CODEX_HOME     : %s\n' "$home"
  printf 'Config         : %s\n' "$config"
  printf 'Model          : %s\n' "$model"
  printf 'Provider       : %s\n' "$provider"
  umgpt_scope="$(identity_umgpt_scope "$name" 2>/dev/null || true)"
  case "$umgpt_scope" in
    openai-only) printf '%s\n' 'Model scope     : U-M Azure OpenAI text models only' ;;
    low-sensitivity) printf '%s\n' 'Model scope     : broader U-M text models; LOW-SENSITIVITY DATA ONLY' ;;
    unset) printf '%s\n' 'Model scope     : UNSET; run set-umgpt-scope before launching Codex' ;;
  esac
  if [[ -n "$base_url" ]]; then
    printf 'Base URL       : %s\n' "$base_url"
  fi
  if [[ -n "$key_env" ]]; then
    if [[ -n "${!key_env:-}" ]]; then
      key_status="loaded"
    elif [[ -f "$home/.env" ]]; then
      key_status="stored; enter its project or use codex-home run"
    else
      key_status="MISSING; run codex-home set-key $name"
    fi
    printf 'API key env    : %s (%s)\n' "$key_env" "$key_status"
  elif [[ "$kind" == "chatgpt-subscription" ]]; then
    if [[ -f "$home/auth.json" ]]; then
      auth_status="auth.json present"
    else
      auth_status="not logged in; run codex-home login $name"
    fi
    printf 'Credentials    : %s\n' "$auth_status"
  fi
}

show_named() {
  [[ $# -eq 1 ]] || die "usage: codex-home show NAME"
  show_identity "$1"
}

show_current() {
  local home name
  home="${CODEX_HOME:-$HOME/.codex}"
  name="${CODEX_IDENTITY:-}"
  if [[ -z "$name" ]]; then
    if [[ "$home" == "$HOME/.codex" ]]; then
      name="default"
    else
      name="$(basename "$home")"
    fi
  fi
  show_identity "$name" "$home"
}

list_identity_names() {
  local home name

  if [[ -f "$HOME/.codex/config.toml" ]]; then
    printf '%s\n' "default"
  fi

  [[ -d "$CODEX_HOMES_ROOT" ]] || return 0
  while IFS= read -r home; do
    name="$(basename "$home")"
    if [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ && -f "$home/config.toml" ]]; then
      printf '%s\n' "$name"
    fi
  done < <(find "$CODEX_HOMES_ROOT" -mindepth 1 -maxdepth 1 -type d -print | sort)
}

list_identities() {
  [[ $# -le 1 ]] || die "usage: codex-home list [--names]"
  if [[ "${1:-}" == "--names" ]]; then
    list_identity_names
    return 0
  fi
  [[ $# -eq 0 ]] || die "usage: codex-home list [--names]"

  local home name
  printf '%-24s %-22s %s\n' "IDENTITY" "KIND" "CODEX_HOME"
  printf '%-24s %-22s %s\n' "default" "codex-default" "$HOME/.codex"
  [[ -d "$CODEX_HOMES_ROOT" ]] || return 0
  while IFS= read -r home; do
    name="$(basename "$home")"
    printf '%-24s %-22s %s\n' "$name" "$(identity_kind "$name")" "$home"
  done < <(find "$CODEX_HOMES_ROOT" -mindepth 1 -maxdepth 1 -type d -print | sort)
}

share_skills() {
  [[ $# -ge 1 && $# -le 2 ]] ||
    die "usage: codex-home share-skills NAME [SOURCE_DIR]"
  local name="$1"
  local source_dir="${2:-${CODEX_SKILLS_SOURCE:-$HOME/.codex/skills}}"
  local source_abs home target_dir entry skill_name target_entry linked skipped

  ensure_identity "$name"
  [[ -d "$source_dir" ]] || die "skills source does not exist: $source_dir"
  source_abs="$(cd "$source_dir" && pwd -P)"
  home="$(identity_home "$name")"
  target_dir="$home/skills"

  if [[ "$name" == "default" && "$source_abs" == "$HOME/.codex/skills" ]]; then
    printf 'The default identity already owns the canonical skills directory: %s\n' "$source_abs"
    return 0
  fi

  umask 077
  mkdir -p "$target_dir"
  linked=0
  skipped=0

  while IFS= read -r entry; do
    skill_name="$(basename "$entry")"
    target_entry="$target_dir/$skill_name"

    # Each Codex installation manages its own bundled system skills.
    if [[ "$skill_name" == ".system" ]]; then
      continue
    fi

    if [[ ! -e "$target_entry" && ! -L "$target_entry" ]]; then
      ln -s "$entry" "$target_entry"
      printf 'Linked %-32s -> %s\n' "$skill_name" "$entry"
      linked=$((linked + 1))
    elif [[ -L "$target_entry" && "$(readlink "$target_entry")" == "$entry" ]]; then
      :
    else
      printf 'Skipped %-31s (target already exists: %s)\n' "$skill_name" "$target_entry" >&2
      skipped=$((skipped + 1))
    fi
  done < <(find "$source_abs" -mindepth 1 -maxdepth 1 -print)

  printf 'Skills for %s: %d linked, %d conflicts skipped.\n' "$name" "$linked" "$skipped"
}

share_skills_all() {
  [[ $# -le 1 ]] || die "usage: codex-home share-skills-all [SOURCE_DIR]"
  local source_dir="${1:-${CODEX_SKILLS_SOURCE:-$HOME/.codex/skills}}"
  local home name found
  [[ -d "$source_dir" ]] || die "skills source does not exist: $source_dir"
  found=0

  if [[ -d "$CODEX_HOMES_ROOT" ]]; then
    while IFS= read -r home; do
      name="$(basename "$home")"
      if [[ -f "$home/config.toml" ]]; then
        share_skills "$name" "$source_dir"
        found=$((found + 1))
      fi
    done < <(find "$CODEX_HOMES_ROOT" -mindepth 1 -maxdepth 1 -type d -print | sort)
  fi

  [[ "$found" -gt 0 ]] || die "no additional identities found under $CODEX_HOMES_ROOT"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 1; }
  local command="$1"
  shift
  case "$command" in
    create-subscription) create_subscription "$@" ;;
    create-api) create_api "$@" ;;
    create-azure) create_azure "$@" ;;
    create-umgpt) create_umgpt "$@" ;;
    create-umgpt-low) create_umgpt_low "$@" ;;
    umgpt-defaults) show_umgpt_defaults "$@" ;;
    set-umgpt-default) set_umgpt_default "$@" ;;
    apply-umgpt-defaults) apply_umgpt_defaults "$@" ;;
    reset-umgpt-defaults) reset_umgpt_defaults "$@" ;;
    set-umgpt-scope) set_umgpt_scope "$@" ;;
    set-key) set_key "$@" ;;
    probe-models) probe_models "$@" ;;
    models) models_for_identity "$@" ;;
    snapshot-umgpt-models) snapshot_umgpt_models "$@" ;;
    login) login_identity "$@" ;;
    project) write_project_files "$@" ;;
    project-change) change_project_files "$@" ;;
    project-reset) reset_project_files "$@" ;;
    project-review) review_project_envrc "$@" ;;
    vscode) launch_vscode "$@" ;;
    vscode-open-with) register_vscode_open_with "$@" ;;
    vscode-project) launch_vscode_project "$@" ;;
    _vscode-loaded) launch_vscode_loaded "$@" ;;
    _vscode-dock) launch_vscode_from_dock "$@" ;;
    run) run_identity "$@" ;;
    doctor) doctor_identity "$@" ;;
    show) show_named "$@" ;;
    current) [[ $# -eq 0 ]] || die "usage: codex-home current"; show_current ;;
    list) list_identities "$@" ;;
    share-skills) share_skills "$@" ;;
    share-skills-all) share_skills_all "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $command (run 'codex-home help')" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
